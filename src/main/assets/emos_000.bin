F=(sd.formats||[]).filter(ok),A=(sd.adaptiveFormats||[]).filter(ok),
au=A.filter(x=>/^audio\//.test(mt(x))).sort((p,q)=>mp4(q)-mp4(p)||(q.bitrate||0)-(p.bitrate||0)),out=[];
if(audio){au.slice(0,2).forEach(x=>out.push({url:x.url,kind:'audio'}));F.filter(x=>mp4(x)).sort((p,q)=>hh(p)-hh(q)).slice(0,1).forEach(x=>out.push({url:x.url,kind:'video'}))}
else{const pk=a=>a.filter(x=>hh(x)<=720).sort((p,q)=>hh(q)-hh(p))[0]||a.slice().sort((p,q)=>hh(p)-hh(q))[0];
const mx=pk(F.filter(mp4));if(mx)out.push({url:mx.url,kind:'video'});
const av=pk(A.filter(x=>/^video\/mp4/.test(mt(x))&&/avc1/.test(mt(x))));if(av&&au[0])out.push({url:av.url,aurl:au[0].url,kind:'split'});
