    installed_apps: S.inst.map(i => i + '=' + APPS[i].n),
    store_apps_not_installed: Object.keys(APPS).filter(i => !S.inst.includes(i) && !APPS[i].sys).map(i => i + '=' + APPS[i].n),
    settings: { accent: S.acc, wallpaper: S.wall, volume: S.vol, brightness: S.br, night_light: S.night, do_not_disturb: S.dnd, muted: S.mute, power: S.pw },
    todos: S.todo.filter(t => !t.d).slice(0, 12).map(t => t.t),
    events_today: S.ev[k] || [],
    home_folder: Object.keys(home).slice(0, 30),
    documents: docs,
    routines: Object.keys(B.macros),
