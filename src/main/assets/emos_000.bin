w.iv=setInterval(()=>rec&&($$(b,'.tm').textContent=fmt0((Date.now()-t0)/1e3)),250);
const stop=()=>{rec=0;mr&&mr.state!='inactive'&&mr.stop();stm&&stm.getTracks().forEach(t=>t.stop());$$(b,'.rc')&&($$(b,'.rc').textContent='⏺ Record')};w.stop=stop;
$$(b,'.rc').onclick=async function(){if(rec)return stop();try{stm=await navigator.mediaDevices.getUserMedia({audio:true})}catch(e){return ntf('Microphone blocked','Allow mic access in your browser')}
ac=ac||AC();an=ac.createAnalyser();ac.createMediaStreamSource(stm).connect(an);ch=[];mr=new MediaRecorder(stm);mr.ondataavailable=e=>ch.push(e.data);mr.onstop=()=>{const bl=new Blob(ch,{type:mr.mimeType}),r=new FileReader(),d=(Date.now()-t0)/1e3;r.onload=()=>{recs.unshift({n:'Recording '+new Date().toLocaleTimeString(),u:r.result,d});R()};r.readAsDataURL(bl)};mr.start();rec=1;t0=Date.now();this.textContent='⏹ Stop'};
b.onclick=e=>{const d=e.target.dataset;if(d.s!=null){const r=recs[d.s];mk(['Users',S.cu,'Documents'])[cn(r.n)+'.webm']=r.u;sv();ntf('Saved to Documents',r.n)}else if(d.x!=null){recs.splice(d.x,1);R()}};
R();dr()}};
})();


(async () => {
  for (const u of S.users)
    if ('pw' in u) {
      u.h = u.pw ? await hs(u.pw) : '';
      delete u.pw;
    }
  if (!(S.v >= 3)) {
    if (S.v != 2) {
      S.inst = cp(D.inst);
      S.pins = cp(D.pins);
    } else S.inst.push('weather', 'convert', 'screenrec');
    S.v = 3;
  }
  if (!(S.v >= 4)) {
    ['browser'].forEach(x => {
      S.inst.includes(x) || S.inst.push(x);
      S.pins.includes(x) || S.pins.unshift(x);
    });
    S.v = 4;
  }
  if (!(S.v >= 5)) {
    ['htmled'].forEach(x => S.inst.includes(x) || S.inst.push(x));
    S.v = 5;
  }
  if (!(S.v >= 6)) {
    ['bubberbot'].forEach(x => {
      S.inst.includes(x) || S.inst.push(x);
      S.pins.includes(x) || S.pins.splice(1, 0, x);
    });
    S.v = 6;
  }
  if (!(S.v >= 7)) {
    ['btunes', 'btube', 'bstudio', 'bvision', 'bradio', 'bphotos', 'brecorder'].forEach(x => {
      S.inst.includes(x) || S.inst.push(x);
      S.pins.includes(x) || S.pins.push(x);
    });
    S.v = 7;
  }
  if (!(S.v >= 8)) {
    ['emulator'].forEach(x => {
      S.inst.includes(x) || S.inst.push(x);
      S.pins.includes(x) || S.pins.push(x);
    });
    S.v = 8;
  }
  S.inst = S.inst.map(i => (i == 'eaglercraft' ? 'minecraft' : i));
  S.pins = S.pins.map(i => (i == 'eaglercraft' ? 'minecraft' : i));
  S.inst = S.inst.filter((i, k) => APPS[i] && S.inst.indexOf(i) == k);
  S.pins = S.pins.filter(i => APPS[i]);
  try {
    delete S.fs.Drives['USB (E:)'];
  } catch (e) {}
  sv();
  apply();
  boot();
})();</script><script data-size=74241001 id=eagdata type=application/octet-stream>