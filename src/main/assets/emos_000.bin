    return 'p:' + s;
  }
};
const isImg = v => /^data:image/.test(v),
  isAV = v => /^data:(audio|video)/.test(v),
  dec = r => {
    try {
      return new TextDecoder().decode(Uint8Array.from(atob(r.split(',')[1]), c => c.charCodeAt(0)));
    } catch (e) {
      return r;
    }
  };
const dl = (n, d, t) => {
  const a = document.createElement('a');
  a.href = /^data:/.test(d) ? d : URL.createObjectURL(new Blob([d], { type: t || 'text/plain' }));
  a.download = n;
  a.click();
};
const pick = (acc, cb, multi) => {
  const i = document.createElement('input');
  i.type = 'file';
  i.accept = acc || '';
  i.multiple = !!multi;
  i.onchange = () =>
    [...i.files].forEach(f => {
      const r = new FileReader();
      r.onload = () => cb(f, r.result);
      r.readAsDataURL(f);
    });
  i.click();
};
const beep = (f = 660) => {
  try {
    const a = new (window.AudioContext || webkitAudioContext)(),
      o = a.createOscillator(),
      g = a.createGain();
    o.frequency.value = f;
    g.gain.value = S.mute ? 0 : S.vol / 300;
    o.connect(g);
    g.connect(a.destination);
    o.start();
    setTimeout(() => a.close(), 350);
  } catch (e) {}
};
