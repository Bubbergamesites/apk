b.innerHTML='<div style="display:flex;gap:10px;align-items:center"><input type=color id=p style="width:70px;height:70px;padding:0;border:0"><div><input id=x size=9><div id=i style=margin-top:6px;opacity:.8></div></div></div><div id=pv style="border-radius:12px;padding:16px;margin:12px 0;text-align:center;font-weight:700"></div><div id=cc style=display:flex;gap:10px></div><div id=pl></div>';
