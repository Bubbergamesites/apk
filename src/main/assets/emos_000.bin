/* ===== Emulator (EmulatorJS, bundled offline inside EmOS) ===== */
(() => {
  /* [group, label, core, [unambiguous file extensions]] */
  const EMS = [
    ['Nintendo', 'NES / Famicom', 'nestopia', ['nes', 'fds', 'unif', 'unf']],
    ['Nintendo', 'SNES / Super Famicom', 'snes9x', ['smc', 'fig', 'sfc', 'gd3', 'gd7', 'dx2', 'bsx', 'swc']],
    ['Nintendo', 'Nintendo 64', 'parallel_n64', ['z64', 'n64', 'v64']],
    ['Nintendo', 'Game Boy / Color', 'gambatte', ['gb', 'gbc']],
    ['Nintendo', 'Game Boy Advance', 'mgba', ['gba']],
    ['Nintendo', 'Nintendo DS', 'melonds', ['nds']],
    ['Nintendo', 'Virtual Boy', 'beetle_vb', ['vb', 'vboy']],
    ['Sony', 'PlayStation', 'pcsx_rearmed', []],
    ['Sony', 'PSP (experimental)', 'ppsspp', ['cso']],
    ['Sega', 'Genesis / Mega Drive', 'genesis_plus_gx', ['md', 'gen', 'smd']],
    ['Sega', 'Master System', 'smsplus', ['sms']],
    ['Sega', 'Game Gear', 'genesis_plus_gx', ['gg']],
    ['Sega', 'Sega CD / 32X', 'picodrive', ['32x']],
    ['Sega', 'Saturn', 'yabause', []],
    ['Atari', 'Atari 2600', 'stella2014', ['a26']],
    ['Atari', 'Atari 5200', 'a5200', ['a52']],
    ['Atari', 'Atari 7800', 'prosystem', ['a78']],
    ['Atari', 'Lynx', 'handy', ['lnx']],
    ['Atari', 'Jaguar', 'virtualjaguar', ['jag', 'j64']],
    ['Other consoles', 'PC Engine / TurboGrafx', 'mednafen_pce', ['pce', 'sgx']],
    ['Other consoles', 'PC-FX', 'mednafen_pcfx', []],
    ['Other consoles', 'Neo Geo Pocket', 'mednafen_ngp', ['ngp', 'ngc']],
    ['Other consoles', 'WonderSwan', 'mednafen_wswan', ['ws', 'wsc']],
    ['Other consoles', 'ColecoVision', 'gearcoleco', ['col', 'cv']],
    ['Other consoles', '3DO', 'opera', []],
    ['Computers', 'Commodore 64', 'vice_x64', ['d64', 't64']],
    ['Computers', 'Commodore 128', 'vice_x128', []],
    ['Computers', 'VIC-20', 'vice_xvic', []],
    ['Computers', 'Plus/4', 'vice_xplus4', []],
    ['Computers', 'Commodore PET', 'vice_xpet', []],
    ['Computers', 'Amiga', 'puae', ['adf', 'adz', 'dms', 'ipf']],
    ['Computers', 'ZX Spectrum', 'fuse', ['tzx', 'tap', 'z80']],
    ['Computers', 'ZX81', '81', ['p81']],
    ['Computers', 'Amstrad CPC', 'cap32', ['dsk', 'cpr']],
    ['Arcade & other', 'Arcade (FBNeo)', 'fbneo', []],
    ['Arcade & other', 'Arcade (MAME 2003 Plus)', 'mame2003_plus', []],
    ['Arcade & other', 'Arcade (MAME 2003)', 'mame2003', []],
    ['Arcade & other', 'Capcom CPS-1', 'fbalpha2012_cps1', []],
    ['Arcade & other', 'Capcom CPS-2', 'fbalpha2012_cps2', []],
    ['Arcade & other', 'Doom (PrBoom)', 'prboom', ['wad']]
  ];
  const EXT = {};
  EMS.forEach((s, i) => s[3].forEach(x => (EXT[x] = i)));
  const GUESS = { iso: 'pcsx_rearmed', bin: 'pcsx_rearmed', cue: 'pcsx_rearmed', img: 'pcsx_rearmed', chd: 'pcsx_rearmed', pbp: 'pcsx_rearmed', zip: 'fbneo', '7z': 'fbneo', rar: 'fbneo' };
  const idxOfCore = c => Math.max(0, EMS.findIndex(s => s[2] == c));
  const groups = [...new Set(EMS.map(s => s[0]))];
  const E = s => String(s).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]);

  /* ---- bundled data: each file lives in its own <script data-emu> and is decoded only when needed ---- */
  const els = {};
  const el = n => els[n] || (els[n] = document.querySelector('script[data-emu="' + n + '"]'));
  window.__emuJobs = window.__emuJobs || {};
  window.__emuNames = () => [...document.querySelectorAll('script[data-emu]')].map(e => e.getAttribute('data-emu'));
  window.__emuB64 = n => {
    const e = el(n);
    return e ? e.textContent.trim() : '';
  };
  window.__emuType = n => {
    const e = el(n);
    return (e && e.getAttribute('data-t')) || 'application/octet-stream';
  };

  /* ---- runs INSIDE the game iframe ---- */
  function emBoot(id) {
    const P = parent,
      J = P.__emuJobs[id],
      paths = {},
      cache = {};
    P.__emuNames().forEach(n =>
      Object.defineProperty(paths, n, {
        enumerable: true,
        get() {
          if (!cache[n]) {
            const r = atob(P.__emuB64(n)),
              u = new Uint8Array(r.length);
            for (let i = 0; i < r.length; i++) u[i] = r.charCodeAt(i);
            cache[n] = URL.createObjectURL(new Blob([u], { type: P.__emuType(n) }));
          }
          return cache[n];
        }
      })
    );
    window.EJS_player = '#game';
    window.EJS_gameName = J.name.replace(/\.[^.]*$/, '');
    window.EJS_biosUrl = '';
    window.EJS_gameUrl = new File([J.file], J.name);
    window.EJS_core = J.core;
    window.EJS_pathtodata = '/';
    window.EJS_paths = paths;
    window.EJS_startOnLoaded = true;
    window.EJS_color = J.color;
    window.EJS_AdUrl = '';
    window.EJS_externalFiles = [];
    window.EJS_ready = () => {};
    window.EJS_onGameStart = () => {
      /* hook point: game started */
    };
    const hook = setInterval(() => {
      if (window.EJS_emulator && window.EJS_emulator.on) {
        clearInterval(hook);
        window.EJS_emulator.on('exit', () => {
          try {
            P.__emuExit && P.__emuExit(id);
          } catch (e) {}
        });
      }
    }, 200);
    const s = document.createElement('script');
    s.textContent = atob(P.__emuB64('loader.js'));
    document.body.appendChild(s);
  }

  /* ---- in-game UI theme (EmulatorJS menus, popups, buttons) matched to EmOS ---- */
  const theme = v => `
:root{--a:${v.a};--g:${v.g};--ln:${v.ln};--r:${v.r};--f:${v.f}}
html,body{background:#050816;color:#e8eaff}
.ejs_parent{background:#050816!important;color:#e8eaff;font-family:var(--f);font-weight:400}
.ejs_parent *,.ejs_parent *::before,.ejs_parent *::after{font-family:var(--f)}
.ejs_game{background:radial-gradient(circle at 30% 20%,rgba(139,92,246,.35),transparent 55%),linear-gradient(160deg,#050a30,#1b0f4a)}
.ejs_parent ::-webkit-scrollbar-track{background:rgba(255,255,255,.08)}
.ejs_start_button{background:var(--a)!important;border-radius:var(--r);font-size:15px;letter-spacing:.08em;height:44px;line-height:44px;padding:0 34px;box-shadow:0 8px 24px rgba(0,0,0,.45)}
.ejs_loading_text{color:#e8eaff;font-size:12px}
.ejs_loading_text_glow{background:var(--g);border:1px solid var(--ln);border-radius:999px;padding:4px 14px;box-shadow:0 6px 20px #0006;backdrop-filter:blur(12px)}
.ejs_big_screen .ejs_menu_bar{background:var(--g);backdrop-filter:blur(18px);-webkit-backdrop-filter:blur(18px);border-top:1px solid var(--ln);padding:8px 10px;color:#e8eaff;border-radius:0}
.ejs_small_screen .ejs_menu_bar{background:var(--g);backdrop-filter:blur(18px);-webkit-backdrop-filter:blur(18px);border:1px solid var(--ln);border-radius:var(--r)}
.ejs_big_screen .ejs_menu_button,.ejs_small_screen .ejs_menu_button{border-radius:8px}
.ejs_big_screen .ejs_menu_text{background:var(--g);color:#e8eaff;border:1px solid var(--ln);border-radius:8px;box-shadow:0 6px 20px #0008;backdrop-filter:blur(12px)}
.ejs_big_screen .ejs_menu_text::before{border-top-color:var(--ln)}
.ejs_small_screen .ejs_menu_text{color:#e8eaff}
.ejs_settings_parent{background:var(--g)!important;border:1px solid var(--ln)!important;border-radius:var(--r)!important;box-shadow:0 12px 40px #0009;backdrop-filter:blur(18px);-webkit-backdrop-filter:blur(18px)}
.ejs_settings_main_bar,.ejs_back_button,.ejs_button_style{color:#c9ccf5;border-radius:8px}
.ejs_settings_main_bar:hover,.ejs_back_button:hover,.ejs_button_style:hover{background:var(--a);color:#fff}
.ejs_settings_main_bar::after{border-left-color:rgba(201,204,245,.6)}
.ejs_back_button::after{border-right-color:rgba(201,204,245,.6)}
.ejs_back_button::before{background:var(--ln);box-shadow:none}
.ejs_option_row::before{background:rgba(255,255,255,.16)}
.ejs_popup_container{background:rgba(5,8,22,.9);backdrop-filter:blur(18px);-webkit-backdrop-filter:blur(18px)}
.ejs_popup_container *{color:#e8eaff!important}
.ejs_popup_container h4{color:var(--a)!important;font-weight:600}
.ejs_button,.ejs_button_button,.ejs_popup_submit,.ejs_control_set_button{background:var(--a)!important;border-radius:8px;color:#fff!important}
.ejs_popup_container .ejs_button,.ejs_popup_container .ejs_button_button,.ejs_popup_container .ejs_popup_submit,.ejs_popup_container .ejs_control_set_button{color:#fff!important}
.ejs_popup_box{background:var(--g)!important;border:1px solid var(--ln);border-radius:var(--r);padding:15px}
.ejs_control_body input[type='text']{background:rgba(0,0,0,.5);border:1px solid var(--ln);border-radius:8px;color:#e8eaff!important}
.ejs_popup_container .ejs_control_selected{background:var(--a)!important;border:0;border-radius:6px}
.ejs_popup_container .ejs_control_selected a{color:#fff!important}
.ejs_control_bar:hover{background:rgba(255,255,255,.08)}
.ejs_context_menu,.ejs_list_selector{background:var(--g);border:1px solid var(--ln);border-radius:10px;backdrop-filter:blur(18px);-webkit-backdrop-filter:blur(18px)}
.ejs_context_menu li a,.ejs_context_menu ul,.ejs_list_selector li a,.ejs_list_selector ul{color:#c9ccf5!important}
.ejs_context_menu li:hover,.ejs_list_selector li:hover{background:var(--a);box-shadow:none;border-radius:8px}
.ejs_context_menu li:hover a,.ejs_list_selector li:hover a{color:#fff!important}
`;

  /* ---- launcher styles (use the OS design tokens, so accent / radius / contrast follow Settings) ---- */
  const CSS = `
.emw{display:flex;flex-direction:column;height:100%;min-height:0}
.emh{flex:1;overflow:auto;padding:18px 20px 26px;display:flex;flex-direction:column;gap:14px;background:radial-gradient(circle at 15% -10%,rgba(139,92,246,.22),transparent 55%)}
.emhero{display:flex;gap:18px;align-items:center;padding:22px;border-radius:18px;background:linear-gradient(135deg,var(--a),#1b0f4a);color:#fff;box-shadow:inset 0 0 0 1px #fff2;flex:none}
.emhero .big{font-size:58px;filter:drop-shadow(0 6px 12px #0006)}
.emhero h2{margin:2px 0 4px}
.emhero small{letter-spacing:2px;opacity:.8}
.emhero div div{opacity:.9}
.emdrop{display:flex;flex-direction:column;align-items:center;gap:4px;padding:28px 16px;border:2px dashed var(--ln);border-radius:16px;background:#fff1;cursor:pointer;transition:.15s;text-align:center;flex:none}
.emdrop:hover,.emdrop.dr{border-color:var(--a);background:rgba(139,92,246,.18);transform:translateY(-1px)}
.emdrop .em1{font-size:38px}
.emdrop small{opacity:.65}
.emcols{display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:10px}
.emg{background:#fff1;border-radius:14px;padding:12px 14px 8px}
.emg b{font-size:13px;opacity:.85}
.emc{cursor:pointer;transition:.12s}
.emc:hover{background:var(--a);color:#fff}
.emc.on{background:var(--a);color:#fff}
.emsel{display:flex;gap:10px;align-items:center;flex:none}
.emsel select{flex:1;min-width:0}
.emtips{margin:0;padding-left:18px;opacity:.8;line-height:1.7}
.emtips kbd{background:#fff2;border:1px solid var(--ln);border-radius:5px;padding:0 6px;font:inherit;font-size:12px}
.emtb{display:flex;gap:8px;align-items:center;padding:8px 10px;background:#0004;border-bottom:1px solid var(--ln);flex:none}
.emtb b{white-space:nowrap;overflow:hidden;text-overflow:ellipsis;min-width:0}
.emtb small{opacity:.6;white-space:nowrap}
.emtb .sp{flex:1}
.emf{flex:1;position:relative;min-height:0;background:#050816}
.emf iframe{position:absolute;inset:0;width:100%;height:100%;border:0;background:#050816}
.emask{margin:auto;width:min(440px,92%);background:var(--g);border:1px solid var(--ln);border-radius:var(--r);padding:20px;display:flex;flex-direction:column;gap:12px;box-shadow:0 12px 40px #0009}
.emask h3{margin:0}
.emask code{display:block;padding:8px 10px;border-radius:8px;background:#0008;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.emask .btns{display:flex;gap:8px;justify-content:flex-end}
`;

  let jid = 0;
  APPS.emulator = {
    n: 'Emulator',
    i: '👾',
    st: 1,
    w: 980,
    h: 660,
    init: (b, w) => {
      if (!document.getElementById('emcss')) {
        const s = document.createElement('style');
        s.id = 'emcss';
        s.textContent = CSS;
        document.head.append(s);
      }
      b.style.cssText = 'padding:0;overflow:hidden;position:relative';
      let sys = -1,
        frame = null,
        cur = null,
        pending = null,
        killJob = null;

      const opts = () =>
        groups.map(g => `<optgroup label="${g}">${EMS.map((s, i) => (s[0] == g ? `<option value=${i}>${E(s[1])}</option>` : '')).join('')}</optgroup>`).join('');

      const stop = () => {
        if (frame) {
          try {
            frame.src = 'about:blank';
          } catch (e) {}
          frame.remove();
          frame = null;
        }
        if (killJob) delete window.__emuJobs[killJob];
        killJob = null;
      };
      w.stop = () => {
        stop();
        delete window.__emuExit;
      };

      const home = () => {
        stop();
        cur = null;
        b.innerHTML = `<div class=emw><div class=emh>
<div class=emhero><div class=big>👾</div><div><small>RETRO GAMING</small><h2>Emulator</h2><div>Play NES, SNES, Game Boy, N64, PlayStation, Genesis, arcade and more. Everything is bundled inside EmOS, so it works fully offline.</div></div></div>
<div class=emdrop id=emdrop><div class=em1>🎮</div><b>Drop a game file here</b><small>or click to browse your files</small><input type=file hidden id=emfile></div>
<div class=emsel><span>System</span><select id=emsys><option value=-1>Auto-detect from file type</option>${opts()}</select></div>
<h4>Supported systems</h4>
<div class=emcols>${groups
          .map(
            g =>
              `<div class=emg><b>${g}</b><div>${EMS.map((s, i) => (s[0] == g ? `<span class="sxch emc ${i == sys ? 'on' : ''}" data-s=${i}>${E(s[1])}</span>` : '')).join('')}</div></div>`
          )
          .join('')}</div>
<h4>Good to know</h4>
<ul class=emtips>
<li>Default keys: arrows to move, <kbd>Z</kbd> / <kbd>X</kbd> for A / B, <kbd>Enter</kbd> for Start, <kbd>V</kbd> for Select. The full map and remapping live in the game's Control Settings, and a gamepad works any time.</li>
<li>Save states and game saves are kept in this browser, per game.</li>
<li>Click a system above to pick it yourself, which helps for disc images (.iso, .bin, .cue) and zipped games.</li>
</ul></div></div>`;
        const dz = b.querySelector('#emdrop'),
          fi = b.querySelector('#emfile'),
          se = b.querySelector('#emsys');
        se.value = sys;
        se.onchange = () => {
          sys = +se.value;
          b.querySelectorAll('.emc').forEach(c => c.classList.toggle('on', +c.dataset.s == sys));
        };
        dz.onclick = () => fi.click();
        fi.onchange = () => fi.files[0] && pick(fi.files[0]);
        b.querySelectorAll('.emc').forEach(c => {
          c.onclick = () => {
            sys = sys == +c.dataset.s ? -1 : +c.dataset.s;
            se.value = sys;
            b.querySelectorAll('.emc').forEach(x => x.classList.toggle('on', +x.dataset.s == sys));
          };
        });
      };

      const pick = f => {
        const ext = (f.name.split('.').pop() || '').toLowerCase();
        if (sys >= 0) {
          const i = sys;
          sys = -1; /* a manual system choice applies to this one game only */
          return play(f, i);
        }
        if (ext in EXT) return play(f, EXT[ext]);
        ask(f, GUESS[ext] ? idxOfCore(GUESS[ext]) : 0);
      };

      const ask = (f, guess) => {
        pending = f;
        stop();
        b.innerHTML = `<div class=emw style="justify-content:center;background:radial-gradient(circle at 15% -10%,rgba(139,92,246,.22),transparent 55%)"><div class=emask>
<h3>Which system is this?</h3><code title="${E(f.name)}">${E(f.name)}</code>
<div>The file type doesn't say which console it belongs to.</div>
<select id=emq>${opts()}</select>
<div class=btns><button class=g id=emno>Cancel</button><button id=emgo>▶ Play</button></div></div></div>`;
        const q = b.querySelector('#emq');
        q.value = guess;
        b.querySelector('#emno').onclick = home;
        b.querySelector('#emgo').onclick = () => play(f, +q.value);
      };

      const play = (f, i) => {
        stop();
        cur = { f, i };
        const cs = getComputedStyle(document.documentElement),
          bs = getComputedStyle(document.body),
          v = n => cs.getPropertyValue(n).trim(),
          a = /^#[0-9a-f]{6}$/i.test(v('--a')) ? v('--a') : '#8b5cf6',
          id = 'j' + ++jid;
        window.__emuJobs[id] = { name: f.name, file: f, core: EMS[i][2], color: a };
        killJob = id;
        window.__emuExit = k => {
          if (killJob == k) home();
        };
        const vars = { a, g: v('--g') || 'rgba(16,20,62,.88)', ln: v('--ln') || 'rgba(139,92,246,.4)', r: v('--r') || '12px', f: bs.fontFamily || 'system-ui,sans-serif' };
        b.innerHTML = `<div class=emw><div class=emtb><button class=g data-a=back>‹ Library</button><b>${E(f.name)}</b><small>${E(EMS[i][1])}</small><span class=sp></span><button class=g data-a=reset title="Restart game">⟲ Restart</button><button class=g data-a=fs title="Fullscreen">⛶</button></div><div class=emf></div></div>`;
        const fr = document.createElement('iframe');
        fr.allow = ['fullscreen', 'autoplay', 'gamepad', 'clipboard-write', 'accelerometer', 'gyroscope'].map(x => x + ' *').join(';');
        fr.srcdoc =
          '<!doctype html><html><head><meta charset=utf-8><meta name=viewport content="width=device-width,initial-scale=1">' +
          '<style>html,body{margin:0;height:100%;background:#050816;overflow:hidden}#game{width:100%;height:100%}</style></head><body><div id=game></div>' +
          '<style>' + theme(vars) + '</style><script>(' + emBoot.toString() + ')(' + JSON.stringify(id) + ')<\/script></body></html>';
        b.querySelector('.emf').append(fr);
        frame = fr;
        b.querySelector('.emtb').onclick = e => {
          const t = e.target.closest('[data-a]');
          if (!t) return;
          const k = t.dataset.a;
          if (k == 'back') home();
          else if (k == 'reset') play(cur.f, cur.i);
          else if (k == 'fs') (frame.requestFullscreen || frame.webkitRequestFullscreen || (() => 0)).call(frame);
        };
      };

      /* drag & drop a game file onto the window at any time */
      b.ondragover = e => {
        e.preventDefault();
        const d = b.querySelector('#emdrop');
        d && d.classList.add('dr');
      };
      b.ondragleave = () => {
        const d = b.querySelector('#emdrop');
        d && d.classList.remove('dr');
      };
      b.ondrop = e => {
        e.preventDefault();
        const d = b.querySelector('#emdrop');
        d && d.classList.remove('dr');
        const f = e.dataTransfer && e.dataTransfer.files[0];
        if (f) pick(f);
      };
      home();
    }
  };
})();


APPS.store={n:'Store',i:'🛍️',sys:1,st:1,w:900,h:620,init:(b,w)=>{
b.style.cssText='padding:0;overflow:hidden;position:relative';
const X=stx(),ks=()=>Object.keys(APPS).filter(k=>!APPS[k].sys),M=k=>SXM[k]||['Fun','Part of EmOS'],has=k=>S.inst.includes(k),
hue=k=>[...k].reduce((a,c)=>a*31+c.charCodeAt(0),7)%360,grad=(k,d=45)=>`linear-gradient(135deg,hsl(${hue(k)} 70% ${d}%),hsl(${(hue(k)+55)%360} 70% ${d-15}%))`,
ico=(k,l)=>`<span class="sxi ${l?'l':''}" style="background:${grad(k)}">${APPS[k].i}</span>`,
sz=k=>Math.max(1,Math.round(String(APPS[k].init||APPS[k].r).length/1024))+' KB',
CI={Games:'🎮',Productivity:'🗂️',Tools:'🧰',Creative:'🎨',Media:'🍿',Internet:'🌐',Education:'🎓',Fun:'🎈'},
btn=k=>`<button class="sxb ${has(k)?'g':''}" data-${has(k)?'o':'i'}=${k}>${has(k)?'Open':'Get'}</button>`,
card=k=>`<div class=sxc data-d=${k}>${ico(k)}<div class=m><b>${esc(APPS[k].n)}</b><small>${M(k)[1]}</small></div>${btn(k)}</div>`,
row=(t,a,s)=>a.length?`<h3 class=sxrh><span>${t}</span>${s?`<a data-t="${s}">See all ›</a>`:''}</h3><div class=sxg>${a.map(card).join('')}</div>`:'';
let tab='disc',q='',hi=0,dk0=0,fr='disc',hov=0;
const fe=()=>['f1gp','emulator','solatro','breakout','colors','passforge','habits','minecraft','bubberbot'].filter(k=>APPS[k]),
sf=f=>{try{return f()}catch(e){console.error('Store:',e);return `<p style=color:#f87171>⚠ ${esc(e.message)}</p>`}},NW=['f1gp','solatro','blusky','globbychase','breakout','passforge','colors','habits'],nwi=k=>{const i=NW.indexOf(k);return i<0?99:i},gm=()=>ks().filter(k=>M(k)[0]=='Games').sort((a,c)=>nwi(a)-nwi(c)),hh=()=>{const L=fe(),f=L[hi%L.length];return `<div class=sxh style="background:${grad(f,40)}"><div class=big>${APPS[f].i}</div><div><small>FEATURED</small><h2>${esc(APPS[f].n)}</h2><div>${M(f)[1]}</div><div class=sxhb>${btn(f)}<button class=g data-d=${f}>Details</button></div></div></div><div class=sxd>${L.map((_,i)=>`<i data-h=${i} class="${i==hi%L.length?'on':''}"></i>`).join('')}</div>`},
used=()=>ks().filter(k=>X.use[k]).sort((a,c)=>X.use[c]-X.use[a]).slice(0,6),
page=()=>{
if(q){const r=ks().filter(k=>(APPS[k].n+M(k)[0]+M(k)[1]).toLowerCase().includes(q));return `<h3>Results for “${esc(q)}”</h3>${r.length?`<div class=sxg>${r.map(card).join('')}</div>`:'<p style=opacity:.6>No apps found.</p>'}`}
if(tab[0]=='@'){const k=tab.slice(1),c=M(k)[0],st=X.rate[k]||0;return `<div class=sxlk data-t="${fr}">‹ ${fr=='disc'?'Discover':fr=='inst'?'Installed':fr}</div><div class=sxdt>${ico(k,1)}<div><h2>${esc(APPS[k].n)}</h2><small style=opacity:.7>${M(k)[1]}</small><div style=margin-top:10px>${btn(k)} ${has(k)?`<button class=g data-rm=${k}>Remove</button>`:''}</div></div></div><span class=sxch>${CI[c]||''} ${c}</span><span class=sxch>💾 ${sz(k)}</span><span class=sxch>${has(k)?'✅ Installed':'⬇ Not installed'}</span><span class=sxch>🚀 ${X.use[k]||0} launches</span><h3>Your rating</h3><div class=sxst>${[1,2,3,4,5].map(n=>`<span class="${n<=st?'on':''}" data-r=${n}>★</span>`).join('')}</div>${row('More in '+c,ks().filter(x=>x!=k&&M(x)[0]==c).slice(0,4))}`}
if(tab=='disc'){return `<div class=sxhw>${sf(hh)}</div>${sf(()=>row('New & noteworthy',NW.filter(k=>APPS[k]).slice(0,6)))}${sf(()=>row('Most used',used()))}${sf(()=>row('Games',gm().slice(0,6),'Games'))}${sf(()=>row('Productivity',ks().filter(k=>M(k)[0]=='Productivity').slice(0,6),'Productivity'))}${sf(()=>row('All apps',ks().sort((a,c)=>APPS[a].n.localeCompare(APPS[c].n))))}`}
if(tab=='inst'){const a=ks().filter(has);return `<h3>Installed (${a.length})</h3><div class=sxg>${a.map(k=>`<div class=sxc data-d=${k}>${ico(k)}<div class=m><b>${esc(APPS[k].n)}</b><small>${sz(k)}</small></div><button class="sxb g" data-rm=${k}>Remove</button></div>`).join('')}</div>${ks().some(k=>!has(k))?'<p><button data-all=1>Install everything</button></p>':''}`}
return `<h3>${CI[tab]||''} ${tab}</h3><div class=sxg>${ks().filter(k=>M(k)[0]==tab).map(card).join('')}</div>`},
nav=()=>{const c=['Games','Productivity','Tools','Creative','Media','Internet','Education','Fun'].filter(c=>ks().some(k=>M(k)[0]==c)),it=(id,i,t,e)=>`<div data-t="${id}" class="${tab==id?'on':''}" title="${t}"><span>${i}</span><span class=l>${t}</span>${e?`<em>${e}</em>`:''}</div>`;return it('disc','✨','Discover')+'<h5>Categories</h5>'+c.map(x=>it(x,CI[x],x)).join('')+'<h5>Library</h5>'+it('inst','📦','Installed',ks().filter(has).length)},
draw=()=>{const p=b.querySelector('.sxp');try{b.querySelector('.sxs').innerHTML=nav()}catch(e){}try{p.innerHTML=page()||'<p style=opacity:.6>Nothing to show here yet.</p>'}catch(e){console.error('Store',e);p.innerHTML='<h3>Couldn\'t load this page</h3><pre style=white-space:pre-wrap;opacity:.8>'+esc(e&&e.stack||e)+'</pre><p><button data-t=disc>Back to Discover</button></p>'}},
get=k=>{if(has(k))return;b.querySelectorAll(`[data-i=${k}]`).forEach(e=>e.outerHTML='<span class=sxpr><i></i></span>');setTimeout(()=>{ins(k);draw()},750)};
b.innerHTML=`<div class=sx><div class=sxs></div><div class=sxw><div class=sxt><input placeholder="🔍 Search apps, games and tools"><small style=opacity:.6>${esc(S.cu)}</small></div><div class=sxp></div></div></div>`;
b.querySelector('input').oninput=e=>{q=e.target.value.trim().toLowerCase();draw()};
b.onclick=e=>{const t=e.target.closest('[data-i],[data-o],[data-d],[data-t],[data-r],[data-rm],[data-h],[data-all]');if(!t)return;e.stopPropagation();const d=t.dataset;
if(d.i)get(d.i);else if(d.o)op(d.o);else if(d.d){fr=tab[0]=='@'?fr:tab;q='';b.querySelector('input').value='';tab='@'+d.d;draw();b.querySelector('.sxp').scrollTop=0}else if(d.t){q='';b.querySelector('input').value='';tab=d.t;draw()}else if(d.h){hi=+d.h;b.querySelector('.sxhw').innerHTML=hh()}else if(d.r){X.rate[tab.slice(1)]=+d.r;sv();draw()}else if(d.rm){ins(d.rm);draw()}else if(d.all){ks().forEach(k=>has(k)||ins(k));draw()}};
b.onmouseenter=()=>hov=1;b.onmouseleave=()=>hov=0;w.iv=setInterval(()=>{const p=b.querySelector('.sxp'),e=b.querySelector('.sxhw');if(tab=='disc'&&!q&&!hov&&e&&p&&p.scrollTop<10){hi++;e.innerHTML=hh()}},6000);draw()}};
APPS.passforge={n:'Password Forge',i:'🔐',st:1,w:420,h:480,init:b=>{
const X=stx(),P=X.pw=Object.assign({len:16,set:'ulns'},X.pw),SETS={u:['A–Z','ABCDEFGHIJKLMNOPQRSTUVWXYZ'],l:['a–z','abcdefghijklmnopqrstuvwxyz'],n:['0–9','0123456789'],s:['!@#','!@#$%^&*()-_=+[]{};:,.?']},q=s=>b.querySelector(s);let pw='',hist=[];
b.innerHTML='<div class=row style=border:0><b id=o style="font:600 17px monospace;word-break:break-all;flex:1"></b><button id=c>Copy</button></div><div class=bar id=e><i></i></div><small id=t></small><div class=row>Length <b id=l></b><input id=r type=range min=6 max=64 style=flex:1></div><div id=k style=display:flex;gap:6px;flex-wrap:wrap></div><button id=g style=margin-top:12px;width:100%>Generate</button><h4>Recent</h4><div id=h></div>';
const draw=()=>{const n=[...P.set].reduce((a,c)=>a+SETS[c][1].length,0)||26,bits=Math.round(P.len*Math.log2(n));q('#o').textContent=pw;const i=q('#e i');i.style.width=Math.min(100,bits/1.28)+'%';i.style.background=bits<50?'#ef4444':bits<80?'#f59e0b':'#22c55e';q('#t').textContent=bits+' bits — '+(bits<50?'weak':bits<80?'good':'excellent');q('#l').textContent=P.len;q('#r').value=P.len;q('#k').innerHTML=Object.keys(SETS).map(c=>`<button class="${P.set.includes(c)?'':'g'}" data-c=${c}>${SETS[c][0]}</button>`).join('');q('#h').innerHTML=hist.slice(1).map(h=>`<div class=row style="font-family:monospace">${esc(h)}</div>`).join('')||'<small>Nothing yet</small>'},
gen=()=>{const pool=[...P.set].map(c=>SETS[c][1]).join('')||SETS.l[1],a=crypto.getRandomValues(new Uint32Array(P.len));pw=[...a].map(x=>pool[x%pool.length]).join('');hist.unshift(pw);hist=hist.slice(0,6);draw()};
q('#r').oninput=e=>{P.len=+e.target.value;gen();sv()};q('#g').onclick=gen;q('#c').onclick=()=>{navigator.clipboard.writeText(pw);ntf('Password copied')};
b.onclick=e=>{const c=e.target.dataset.c;if(c){P.set=P.set.includes(c)?P.set.replace(c,''):P.set+c;gen();sv()}};gen()}};
APPS.colors={n:'Color Studio',i:'🎨',st:1,w:460,h:560,init:b=>{
const q=s=>b.querySelector(s);let hex='#8b5cf6';
const rgb=h=>[1,3,5].map(i=>parseInt(h.slice(i,i+2),16)),hsl=h=>{let[r,g,b]=rgb(h).map(x=>x/255),m=Math.max(r,g,b),n=Math.min(r,g,b),l=(m+n)/2,d=m-n,s=d?d/(1-Math.abs(2*l-1)):0,H=d?(m==r?((g-b)/d+6)%6:m==g?(b-r)/d+2:(r-g)/d+4)*60:0;return[Math.round(H),Math.round(s*100),Math.round(l*100)]},
fromHsl=(h,s,l)=>{s/=100;l/=100;const f=n=>{const k=(n+h/30)%12,a=s*Math.min(l,1-l);return Math.round(255*(l-a*Math.max(-1,Math.min(k-3,9-k,1))))};return'#'+[f(0),f(8),f(4)].map(x=>x.toString(16).padStart(2,'0')).join('')},
lum=h=>{const[r,g,b]=rgb(h).map(x=>{x/=255;return x<=.03928?x/12.92:Math.pow((x+.055)/1.055,2.4)});return .2126*r+.7152*g+.0722*b},
