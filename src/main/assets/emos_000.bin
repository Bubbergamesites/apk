v.addEventListener('play',()=>{sk();a.play().catch(()=>{})});v.addEventListener('playing',()=>{sk();a.play().catch(()=>{})});v.addEventListener('pause',()=>a.pause());v.addEventListener('waiting',()=>a.pause());
v.addEventListener('seeking',()=>{a.currentTime=v.currentTime});v.addEventListener('seeked',sk);v.addEventListener('ratechange',g);v.addEventListener('volumechange',g);v.addEventListener('ended',()=>a.pause());
const iv=setInterval(()=>{if(!v.isConnected){clearInterval(iv);a.pause();a.removeAttribute('src');a.load();return}if(!v.paused&&Math.abs(a.currentTime-v.currentTime)>.4)a.currentTime=v.currentTime},1500);g()};
