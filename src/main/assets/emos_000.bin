const preq = async p => {
  try {
    if (p == 'camera' || p == 'microphone')
      (await navigator.mediaDevices.getUserMedia(p == 'camera' ? { video: 1 } : { audio: 1 }))
        .getTracks()
        .forEach(t => t.stop());
    else if (p == 'geolocation')
      await new Promise((a, b) => navigator.geolocation.getCurrentPosition(a, b));
    else if (p == 'notifications') await Notification.requestPermission();
    else await navigator.clipboard.readText();
  } catch (e) {
    ntf('Permission', e.message || 'denied');
  }
