    return [...crypto.getRandomValues(new Uint32Array(20))].map(x => A[x % A.length]).join('');
  },
  Timestamp: s =>
    +s ? new Date(+s * (s.length < 12 ? 1000 : 1)).toISOString() : String(Date.now()),
  'Word count': s =>
    `${s.trim().split(/\s+/).filter(Boolean).length} words, ${s.length} chars, ${s.split('\n').length} lines`,
  UPPER: s => s.toUpperCase(),
  lower: s => s.toLowerCase(),
  'Sort lines': s => s.split('\n').sort().join('\n'),
  Reverse: s => [...s].reverse().join('')
};
const cmd = async (v, o) => {
  const [c, ...a] = v.split(' '),
    p = a[0] || '',
    q = a.join(' '),
    d = () => gt(tcw),
    F = n => d()[n],
    nf = 'no such file',
    tr = (x, i = '') =>
      Object.keys(x)
        .map(k => i + k + (typeof x[k] == 'object' ? '/\n' + tr(x[k], i + '  ') : ''))
        .join('\n'),
    u = x => (/^http/.test(x) ? x : 'https://' + x);
  const C = {
    help: () =>
      'ls cd pwd cat mkdir touch rm mv cp echo(>,>>) grep wc head find tree date whoami uname uptime neofetch ps kill free df ping curl js theme notify open edit clear lock',
    ls: () =>
      Object.keys(d())
        .map(k => (typeof d()[k] == 'object' ? k + '/' : k))
        .join('  '),
    cd: () => {
      if (p == '..') tcw.length > 1 && tcw.pop();
      else if (p == '/' || p == '~') tcw.splice(0, 9, 'Users', S.cu);
      else if (typeof F(p) == 'object') tcw.push(p);
      else return 'no such dir';
      return '/' + tcw.join('/');
    },
    pwd: () => '/' + tcw.join('/'),
    cat: () => (typeof F(p) == 'string' ? F(p) : nf),
    mkdir: () => {
      d()[cn(p)] = {};
      sv();
    },
    touch: () => {
      F(p) === undefined && (d()[cn(p)] = '');
      sv();
    },
    rm: () => {
      delete d()[p];
      sv();
    },
    mv: () => {
      d()[cn(a[1])] = F(p);
      delete d()[p];
      sv();
    },
    cp: () => {
      d()[cn(a[1])] = cp2(F(p));
      sv();
    },
    echo: () => {
      const m = q.match(/^(.*?)\s*(>>?)\s*(\S+)$/);
      if (!m) return q;
      const n = cn(m[3]),
        ap = m[2] == '>>';
      d()[n] = (ap ? d()[n] || '' : '') + m[1] + (ap ? '\n' : '');
      sv();
    },
    grep: () =>
      (F(a[1]) || '')
        .split('\n')
        .filter(l => l.includes(p))
        .join('\n') || 'no match',
    wc: () => {
      const t = F(p) || '';
      return `${t.split('\n').length} lines ${t.split(/\s+/).filter(Boolean).length} words ${t.length} chars`;
    },
    head: () => (F(p) || '').split('\n').slice(0, 10).join('\n'),
    find: () => {
      const r = [];
      walk(d(), '', r);
      return r.filter(x => x.toLowerCase().includes(p.toLowerCase())).join('\n') || 'none';
    },
    tree: () => tr(d()),
    date: () => new Date().toString(),
    whoami: () => S.cu + (adm() ? ' (admin)' : ''),
    uname: () => 'EmOS 2.0 on ' + navigator.platform,
    uptime: () => (((Date.now() - UP) / 1000) | 0) + 's',
    neofetch: () =>
      `EmOS 2.0\nUser: ${S.cu}\nCores: ${navigator.hardwareConcurrency}\nHeap: ${HEAP}\nScreen: ${screen.width}x${screen.height}\nFPS: ${FPS}\nAccent: ${S.acc}`,
    ps: () =>
      Object.values(W)
        .map(w => w.pid + ' ' + APPS[w.id].n)
        .join('\n'),
    kill: () => {
      const w = Object.values(W).find(x => x.pid == p);
      w && cl(w.k);
      return w ? 'killed' : 'no such pid';
    },
    free: () => 'JS heap: ' + HEAP,
    df: () => SU,
    ping: async () => {
      const t = performance.now();
      try {
        await fetch(u(p), { mode: 'no-cors', cache: 'no-store' });
        return 'reply in ' + ((performance.now() - t) | 0) + ' ms';
      } catch (e) {
