    if (!d || typeof d != 'object') return bbNO('Folder not found');
    return bbOK('Listed ' + (a.path || 'home'), { data: { path: a.path || '', items: Object.keys(d).slice(0, 80).map(k => (typeof d[k] == 'object' ? { name: k, type: 'folder' } : { name: k, type: 'file', kb: +(d[k].length / 1024).toFixed(1) })) } });
  },
  open_file: a => {
    const p = bbPath(a.path);
    if (!p) return bbNO('Invalid path');
    const n = p.pop(),
      d = sub(p);
    if (!d || d[n] === undefined) return bbNO('File not found');
