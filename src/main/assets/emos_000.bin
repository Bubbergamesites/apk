const sz = (w, x, y, a, b) => {
  if (!w.pr) w.pr = w.e.style.cssText;
  Object.assign(w.e.style, { left: x + 'px', top: y + 'px', width: a + 'px', height: b + 'px' });
};
function mx(k) {
  const w = W[k];
  if (w.max) {
    w.e.style.cssText = w.pr;
    w.pr = 0;
    w.max = 0;
  } else {
    sz(w, 0, 0, $('#desk').clientWidth, $('#desk').clientHeight);
    w.max = 1;
  }
}
function snap(w, x, y, l) {
  const a = $('#desk').clientWidth,
    b = $('#desk').clientHeight;
  if (y < 6 && !l) return mx(w.k);
  if (x < 6 || l == 1) sz(w, 0, 0, a / 2, b);
  else if (x > innerWidth - 6 || l == 2) sz(w, a / 2, 0, a / 2, b);
}
function drag(w) {
  const t = w.e.firstChild;
  t.onpointerdown = ev => {
    if (ev.target.tagName == 'I') return;
    if (w.max) {
      w.e.style.cssText = w.pr;
      w.pr = 0;
      w.max = 0;
    }
    const r = w.e.getBoundingClientRect(),
      dx = ev.clientX - r.left,
      dy = ev.clientY - r.top,
      p = $('#desk').getBoundingClientRect();
    t.setPointerCapture(ev.pointerId);
    t.onpointermove = m => {
      w.e.style.left = m.clientX - dx - p.left + 'px';
      w.e.style.top = Math.max(0, m.clientY - dy - p.top) + 'px';
    };
    t.onpointerup = m => {
      t.onpointermove = null;
      snap(w, m.clientX, m.clientY - p.top);
    };
  };
}
function tile() {
  const v = Object.values(W).filter(w => w.d == DK && !w.min),
    n = v.length;
  if (!n) return;
  const c = Math.ceil(Math.sqrt(n)),
    r = Math.ceil(n / c),
    a = $('#desk').clientWidth / c,
    b = $('#desk').clientHeight / r;
  v.forEach((w, i) => {
    w.pr = w.pr || w.e.style.cssText;
    w.max = 0;
    Object.assign(w.e.style, {
      left: (i % c) * a + 'px',
      top: ((i / c) | 0) * b + 'px',
      width: a + 'px',
      height: b + 'px'
    });
  });
}
const R = () =>
