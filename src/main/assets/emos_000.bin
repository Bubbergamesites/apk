    R();
    return bbOK('Completed: ' + t.t);
  },
  add_note: a => {
    S.notes.push({ t: String(a.text || '').slice(0, 2000), c: /^#[0-9a-f]{6}$/i.test(a.color) ? a.color : '#6d28d9' });
    sv();
    R();
    return bbOK('Added a sticky note');
  },
  add_event: a => {
    const m = String(a.date || '').match(/^(\d{4})-(\d{1,2})-(\d{1,2})$/);
    if (!m || !String(a.text || '').trim()) return bbNO('Need a date (YYYY-MM-DD) and text');
    const k = `${+m[1]}-${+m[2]}-${+m[3]}`;
    (S.ev[k] = S.ev[k] || []).push(String(a.text).trim().slice(0, 120));
    sv();
    return bbOK('Added calendar event on ' + a.date);
  },
  add_alarm: a => {
    const m = String(a.time || '').match(/^(\d{1,2}):(\d{2})$/);
    if (!m || +m[1] > 23 || +m[2] > 59) return bbNO('Need a time like 07:30');
    const t = String(m[1]).padStart(2, '0') + ':' + m[2];
    S.alarms.push({ t, on: 1 });
    sv();
    return bbOK('Alarm set for ' + t);
  },
  start_timer: a => {
    const m = Math.max(0.1, Math.min(600, +a.minutes || 0));
