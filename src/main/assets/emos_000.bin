      return null;
    }
  },
  mk = p => p.reduce((o, k) => (typeof o[k] == 'object' ? o[k] : (o[k] = {})), S.fs),
  cp2 = x => (typeof x == 'object' ? cp(x) : x),
  cn = s => s.replace(/[^\w .-]/g, '').slice(0, 40),
  esc = s =>
