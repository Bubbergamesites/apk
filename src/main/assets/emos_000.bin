    if (!ap) return { need: 1, msg: 'Uninstall ' + APPS[id].n, act: { do: 'uninstall_app', app: id } };
    un(id);
    return bbOK('Uninstalled ' + APPS[id].n);
  },
  web_search: a => {
    const q = String(a.query || '').trim().slice(0, 200);
