    },
    clear: () => {
      o.textContent = '';
    },
    lock: () => {
      lk();
    }
  };
  return v ? (C[c] ? await C[c]() : 'command not found: ' + c) : null;
};
/* ===== BubberBot: AI helper + OS automation ===== */
const BB = { busy: 0, render: null };
const BBC = { red: '#ef4444', orange: '#f97316', yellow: '#eab308', green: '#22c55e', teal: '#14b8a6', cyan: '#06b6d4', blue: '#3b82f6', purple: '#8b5cf6', violet: '#7c3aed', pink: '#ec4899', magenta: '#d946ef' };
const BBAL = { internet: 'browser', web: 'browser', 'file manager': 'files', explorer: 'files', 'task manager': 'monitor', terminal: 'term', console: 'term', calculator: 'calc', 'sticky notes': 'notes', 'text editor': 'editor', 'html editor': 'htmled', music: 'media', video: 'media', photos: 'viewer', pictures: 'viewer', 'mine craft': 'minecraft', 'app store': 'store', emulator: 'emulator', 'retro games': 'emulator', 'game emulator': 'emulator' };
const BBSAFE = ['ls', 'cat', 'pwd', 'tree', 'find', 'grep', 'wc', 'head', 'date', 'whoami', 'uname', 'uptime', 'neofetch', 'ps', 'free', 'df', 'ping'];
const BBT = { 'night light': 'night', 'night mode': 'night', 'do not disturb': 'dnd', dnd: 'dnd', 'power saver': 'pw', animations: 'anim', 'high contrast': 'hc', 'large text': 'big', 'big text': 'big', captions: 'cap', magnifier: 'mag', 'screen reader': 'sr' };
const bbOK = (msg, x) => ({ ok: 1, msg, ...x }),
  bbNO = msg => ({ ok: 0, msg });
const bbInit = () => {
  const B = (S.bbot = S.bbot || {});
  B.cfg = Object.assign({ provider: 'free', url: 'https://text.pollinations.ai/openai', key: '', model: 'openai', speak: 0 }, B.cfg || {});
  B.chat = B.chat || [];
  B.hist = B.hist || [];
  B.macros = B.macros || {};
  B.jobs = B.jobs || [];
  return B;
};
const bbApp = q => {
  q = String(q || '').toLowerCase().replace(/\b(the|app|application|my|please)\b/g, '').replace(/\s+/g, ' ').trim();
  if (!q) return null;
  if (BBAL[q]) return BBAL[q];
  const ids = Object.keys(APPS), nm = i => APPS[i].n.toLowerCase();
  const fz = q.length > 2;
  return ids.find(i => i == q) || ids.find(i => nm(i) == q) || (fz && (ids.find(i => nm(i).includes(q)) || ids.find(i => q.includes(nm(i))) || ids.find(i => i.includes(q)))) || null;
};
const bbPath = p => {
  let a = String(p || '').split('/').map(x => x.trim()).filter(Boolean);
  if (a.some(x => x == '..' || x == '.')) return null;
  a = a.map(x => cn(x));
  if (a.some(x => !x)) return null;
  if (a[0] == 'Users') {
    if (a[1] != S.cu) return null;
  } else a = ['Users', S.cu, ...a];
  return a;
};
const bbBool = v => (v === true || v === 1 || v === '1' || /^(on|true|yes)$/i.test(v) ? 1 : v === false || v === 0 || v === '0' || /^(off|false|no)$/i.test(v) ? 0 : null);
const bbInt = (a, b) => v => {
  v = Math.round(+v);
  return v >= a && v <= b ? v : null;
};
const BBV = {
  acc: v => (/^#[0-9a-f]{6}$/i.test(v) ? v : BBC[String(v).toLowerCase()] || null),
  wall: bbInt(0, 3),
  vol: bbInt(0, 100),
  br: bbInt(30, 100),
  rad: bbInt(0, 24),
  pw: v => (['balanced', 'saver'].includes(v) ? v : null),
  idle: v => ([0, 1, 5, 15, 30].includes(+v) ? +v : null),
  scale: v => (['0.9', '1', '1.1', '1.25', '1.5'].includes(String(v)) ? String(v) : null)
};
['night', 'dnd', 'mute', 'anim', 'big', 'hc', 'mag', 'cap', 'sr'].forEach(k => (BBV[k] = bbBool));
const bbClean = l =>
  (Array.isArray(l) ? l : [])
