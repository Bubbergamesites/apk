const T = {
  'JSON pretty': s => J(JSON.parse(s), null, 2),
  'JSON minify': s => J(JSON.parse(s)),
  'Base64 enc': s => btoa(unescape(encodeURIComponent(s))),
  'Base64 dec': s => decodeURIComponent(escape(atob(s))),
  'URL enc': encodeURIComponent,
  'URL dec': decodeURIComponent,
  'SHA-256': async s =>
    [...new Uint8Array(await crypto.subtle.digest('SHA-256', new TextEncoder().encode(s)))]
