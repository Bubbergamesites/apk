const cv=$$(b,'canvas'),c=cv.getContext('2d'),LS=$$(b,'.ls'),R=()=>LS.innerHTML=recs.map((r,i)=>`<div class=row><span>🎧 ${esc(r.n)} <small style=opacity:.6>${fmt0(r.d)}</small></span><span><audio src="${r.u}" controls style="height:28px;width:170px"></audio> <button class=g data-s=${i}>💾</button> <button class=g data-x=${i}>✕</button></span></div>`).join('')||'<p style=opacity:.6>No recordings yet.</p>',fmt0=s=>(s/60|0)+':'+String(s%60|0).padStart(2,'0');
