const BBA = {
  open_app: a => {
    const id = bbApp(a.app);
    if (!id) return bbNO('No app called “' + a.app + '”');
    op(id);
    return bbOK('Opened ' + APPS[id].n);
  },
  close_app: a => {
    const id = bbApp(a.app),
      w = Object.values(W).find(x => x.id == id);
    if (!w) return bbNO('That app isn’t open');
    cl(w.k);
    return bbOK('Closed ' + APPS[id].n);
  },
  close_all: () => {
    const v = Object.values(W).filter(w => w.id != 'bubberbot');
    v.forEach(w => cl(w.k));
    return bbOK('Closed ' + v.length + ' window(s)');
  },
  switch_desktop: a => {
    const n = Math.max(1, Math.min(4, Math.round(+a.n) || 1));
    sd(n - 1);
    return bbOK('Switched to desktop ' + n);
  },
  tile_windows: () => {
    tile();
    return bbOK('Tiled your windows');
  },
  lock: () => {
    setTimeout(lk, 700);
    return bbOK('Locking the screen…');
  },
  set_setting: a => {
    const k = String(a.key);
    if (!Object.prototype.hasOwnProperty.call(BBV, k)) return bbNO('I can’t change “' + k + '”');
    const v = BBV[k](a.value);
    if (v === null) return bbNO('Invalid value for ' + k);
    if (k == 'wall') S.wallImg = '';
    set(k, v);
    return bbOK('Set ' + k + ' to ' + v);
  },
  notify: a => {
    ntf(String(a.title || 'BubberBot').slice(0, 60), String(a.body || '').slice(0, 200));
    return bbOK('Sent a notification');
  },
  add_todo: a => {
    const t = String(a.text || '').trim().slice(0, 200);
    if (!t) return bbNO('Empty to-do');
    S.todo.push({ t, d: 0 });
    sv();
    R();
    return bbOK('Added to-do: ' + t);
  },
  complete_todo: a => {
    const q = String(a.text || '').toLowerCase(),
      t = S.todo.find(x => !x.d && x.t.toLowerCase().includes(q));
    if (!t) return bbNO('No matching to-do');
