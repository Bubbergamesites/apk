const yprobe=(u,k)=>new Promise((res,rej)=>{const m=document.createElement(k=='audio'?'audio':'video');let t;const end=(f,x)=>{clearTimeout(t);m.onloadedmetadata=m.onerror=null;m.removeAttribute('src');try{m.load()}catch(e){}f(x)};
t=setTimeout(()=>end(rej,new Error('timeout')),8000);m.preload='metadata';m.muted=true;m.onloadedmetadata=()=>end(res);m.onerror=()=>end(rej,new Error('media'));m.src=u});
