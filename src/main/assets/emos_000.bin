const G=$$(b,'.bs'),sound=(c,i,t)=>{const n=(len,hp,gn)=>{const bf=c.createBuffer(1,c.sampleRate*len|0,c.sampleRate),d=bf.getChannelData(0);for(let k=0;k<d.length;k++)d[k]=Math.random()*2-1;const s=c.createBufferSource(),f=c.createBiquadFilter(),gg=c.createGain();f.type='highpass';f.frequency.value=hp;s.buffer=bf;gg.gain.setValueAtTime(gn,t);gg.gain.exponentialRampToValueAtTime(.001,t+len);s.connect(f);f.connect(gg);gg.connect(c.destination);s.start(t)};
