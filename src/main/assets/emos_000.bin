const R=()=>{b.innerHTML=`<style>@keyframes eqb{50%{height:90%}}.eqv{display:inline-flex;gap:2px;align-items:flex-end;height:16px}.eqv s{width:3px;background:var(--a);height:20%;animation:eqb .6s infinite}.eqv s:nth-child(2){animation-delay:.2s}.eqv s:nth-child(3){animation-delay:.4s}</style><div class=row style=margin:0><span style=font-size:15px>${cur?`<b>${esc(cur[0])}</b> ${ok&&!au.paused?'<span class=eqv><s></s><s></s><s></s></span>':''}<br><small class=stt style=opacity:.7>${esc(msg)}</small>`:'<b>Pick a station</b><br><small style=opacity:.7>Streams by SomaFM (internet required)</small>'}</span><span><button class="g pb" data-st>${cur&&!au.paused?'⏸':'▶'}</button></span></div><div class=row style=margin:0>Volume <input type=range class=vl min=0 max=100 value=${st.vol} style=flex:1><button class=g data-cu>＋ Custom URL</button></div><div style="padding:6px 0">${['All','⭐',...gen()].map(g=>`<button class="${flt==g?'':'g'}" data-g="${esc(g)}" style="margin:2px">${esc(g)}</button>`).join('')}</div>`+(all().filter(x=>flt=='All'||(flt=='⭐'?st.f.includes(x[2]):x[1]==flt)).map(x=>`<div class=row style=cursor:pointer data-s="${esc(x[2])}"><span style="${cur&&cur[2]==x[2]?'color:var(--a)':''}">📻 <b>${esc(x[0])}</b> <small style=opacity:.6>${esc(x[1])}</small></span><button class=g data-fv="${esc(x[2])}">${st.f.includes(x[2])?'⭐':'☆'}</button></div>`).join('')||'<p style=opacity:.6>No stations here yet.</p>')};
/* try the next server for the current station; give up with a clear message when all have failed */
const next=()=>{clearTimeout(tm);if(!cur)return;if(ci>=cands.length){ok=0;setMsg('Couldn\'t connect to this station. Check your connection or try another.');upd();return}
