w.stop=()=>clearInterval(tm);
b.onchange=e=>{if(e.target.classList.contains('fl')){flt=e.target.value;L()}};
b.onclick=e=>{const T=e.target.closest('[data-i],[data-up],[data-art],[data-ss],[data-bk],[data-pv],[data-nx],[data-rt],[data-zi],[data-zo],[data-dw],[data-rm]');if(!T)return;const d=T.dataset;
if(d.i!=null){cur=+d.i;rot=0;zm=1;L()}else if(d.up!=null)pick('image/*',(f,u)=>{mk(['Users',S.cu,'Pictures'])[cn(f.name)]=u;sv();G()},1)
else if(d.art!=null){const c=document.createElement('canvas');c.width=800;c.height=500;const x=c.getContext('2d'),h=Math.random()*360,g=x.createLinearGradient(0,0,800,500);g.addColorStop(0,`hsl(${h} 80% 40%)`);g.addColorStop(1,`hsl(${h+80} 80% 20%)`);x.fillStyle=g;x.fillRect(0,0,800,500);for(let i=0;i<40;i++){x.fillStyle=`hsla(${h+Math.random()*120} 90% 60% / .18)`;x.beginPath();x.arc(Math.random()*800,Math.random()*500,10+Math.random()*90,0,7);x.fill()}mk(['Users',S.cu,'Pictures'])['art-'+Date.now()+'.png']=c.toDataURL();sv();G()}
else if(d.ss!=null){if(!imgs().length)return;cur=0;L();tm=setInterval(()=>b.isConnected&&go(1),3000)}else if(d.bk!=null){clearInterval(tm);G()}else if(d.pv!=null){clearInterval(tm);go(-1)}else if(d.nx!=null)go(1);else if(d.rt!=null){rot+=90;L()}else if(d.zi!=null){zm*=1.25;L()}else if(d.zo!=null){zm/=1.25;L()}
