      b.onclick = () => i.focus();
      i.onkeydown = async e => {
        if (e.key == 'ArrowUp') {
          hp > 0 && hp--;
          i.value = hh[hp] || '';
        } else if (e.key == 'ArrowDown') {
          hp < hh.length - 1 ? (i.value = hh[++hp]) : ((i.value = ''), (hp = hh.length));
        } else if (e.key == 'Enter') {
          const v = i.value.trim();
          i.value = '';
          v && hh.push(v);
          hp = hh.length;
          o.append('$ ' + v + '\n');
          const r = await cmd(v, o).catch(x => 'Error: ' + x.message);
          r != null && o.append(r + '\n');
          o.scrollTop = 1e9;
        }
      };
    }
  },
  sec: {
    n: 'Security',
    i: '🛡️',
    sys: 1,
    w: 520,
    h: 480,
    init: () => {
      pq();
    },
    r: () =>
      `<div class=row>Secure context<b>${isSecureContext ? '✅ yes' : '⚠️ no'}</b></div><div class=row>Passwords stored as SHA-256 hashes<b>${window.crypto && crypto.subtle ? '✅' : '⚠️ unavailable'}</b></div><div class=row>Cookies enabled<b>${navigator.cookieEnabled ? '✅' : '❌'}</b></div><h4>Browser permissions</h4>` +
      ['camera', 'microphone', 'geolocation', 'notifications', 'clipboard-read']
        .map(
          p =>
            `<div class=row>${p}<span>${PM[p] || '…'} <button class=g onclick="preq('${p}')">Request</button></span></div>`
        )
        .join('') +
      `<h4>Authentication</h4>${sl('idle', 'Auto-lock after (min, 0=never)', ['0', '1', '5', '15', '30'])}<small>3 wrong passwords lock sign-in for 30 s.</small><h4>Sign-in history</h4>` +
      S.hist
        .slice(0, 6)
        .map(h => `<div class=row><small>${esc(h)}</small></div>`)
        .join('') +
      `<h4>Storage</h4><div class=row>${SU}<button class=g onclick="if(confirm('Erase all EmOS data?')){localStorage.clear();location.reload()}">Erase all data</button></div>`
  },
  net: {
    n: 'Network',
    i: '🌐',
    sys: 1,
    w: 520,
    r: () => {
      const c = navigator.connection || {};
      return `<div class=row>Status<b>${navigator.onLine ? '🟢 Online' : '🔴 Offline'}</b></div><div class=row>Connection<span>${c.effectiveType || 'n/a'}${c.type ? ' / ' + c.type : ''}</span></div><div class=row>Downlink<span>${c.downlink ?? 'n/a'} Mbps</span></div><div class=row>Round-trip<span>${c.rtt ?? 'n/a'} ms</span></div><div class=row>Data saver<span>${c.saveData ? 'on' : 'off'}</span></div><div class=row>Public IP<span>${NI}</span></div><div class=row><button onclick="nip()">Look up public IP</button><button onclick="nlat()">Latency test</button></div><div class=row><input id=pu placeholder="example.com" style=flex:1><button onclick="npg()">Ping</button></div><pre style="white-space:pre-wrap">${esc(NO)}</pre>`;
    }
  },
  dev: {
    n: 'Devices',
    i: '🔌',
    sys: 1,
    w: 560,
    h: 500,
    r: () => {
      const g = (navigator.getGamepads ? [...navigator.getGamepads()] : []).filter(Boolean);
      let gl = '';
      try {
        const x = document.createElement('canvas').getContext('webgl'),
          e = x.getExtension('WEBGL_debug_renderer_info');
        gl = e ? x.getParameter(e.UNMASKED_RENDERER_WEBGL) : '';
      } catch (e) {}
      return (
        `<h4>Audio & video devices</h4><button onclick="dscan()">Detect devices (asks permission)</button> <button class=g onclick="op('camera')">📷 Camera</button>` +
        (MD.map(
          d =>
            `<div class=row>${d.kind == 'audioinput' ? '🎤' : d.kind == 'videoinput' ? '📷' : '🔊'} ${esc(d.label || d.kind)}</div>`
        ).join('') || '<p>Nothing scanned yet</p>') +
        `<h4>Bluetooth</h4><button onclick="btscan()">Scan for a Bluetooth device</button>` +
        BTD.map(d => `<div class=row>🔷 ${esc(d)}</div>`).join('') +
        `<h4>Game controllers</h4>` +
        (g.map(x => `<div class=row>🎮 ${esc(x.id.slice(0, 50))}</div>`).join('') ||
          '<p>Press a button on a controller</p>') +
        `<h4>This device</h4><div class=row>Platform<span>${esc(navigator.platform)}</span></div><div class=row>Graphics<span>${esc(gl || 'n/a')}</span></div><div class=row>Touch points<span>${navigator.maxTouchPoints}</span></div><div class=row>Language / zone<span>${navigator.language} · ${Intl.DateTimeFormat().resolvedOptions().timeZone}</span></div>`
      );
    }
  },
  backup: {
    n: 'Backup',
    i: '💾',
    sys: 1,
    w: 520,
    r: () =>
      `<div class=row><button onclick="bk()">Create restore point</button><span><button class=g onclick="bex()">⬇ Export file</button> <button class=g onclick="bim()">⬆ Import file</button></span></div><small>Backups cover files, notes, tasks, events, alarms and theme (not passwords).</small><h4>Restore points</h4>` +
      (S.bk
        .map(
          (b, i) =>
            `<div class=row>${b.t}<span><button class=g onclick="rs(${i})">Restore</button><button class=g onclick="S.bk.splice(${i},1);sv();R()">✕</button></span></div>`
        )
        .join('') || '<p>None yet</p>')
  },
  logs: {
    n: 'Logs',
    i: '📜',
    sys: 1,
    w: 560,
    r: () =>
      `<button onclick="dg()">Run diagnostics</button> <button class=g onclick="LG=[];R()">Clear</button><pre style="white-space:pre-wrap">${esc(LG.map(l => l.join(' | ')).join('\n'))}</pre>`
  },
  clip: {
    n: 'Clipboard',
    i: '📋',
    sys: 1,
    w: 480,
    r: () =>
      `<div class=row><button onclick="navigator.clipboard.readText().then(t=>{t&&CB.unshift(t);R()}).catch(()=>ntf('Clipboard blocked','Allow clipboard access'))">Import system clipboard</button><button class=g onclick="CB=[];R()">Clear</button></div>` +
      (CB.map(
        (c, i) =>
          `<div class=row><span>${esc(c.slice(0, 100))}</span><button class=g onclick="cpb(${i})">Copy</button></div>`
      ).join('') || '<p>Copy text in any EmOS window to build history</p>')
  },
  editor: {
    n: 'Editor',
    i: '✏️',
    sys: 1,
    st: 1,
    w: 620,
    h: 440,
    init: (b, w) => {
      b.style.cssText = 'display:flex;flex-direction:column;gap:6px';
      b.innerHTML = `<div class=row style="padding:0"><input style=flex:1 placeholder="Users/${esc(S.cu)}/Documents/file.txt"><button>💾 Save</button><button class=g>New</button><select><option>12</option><option>14</option><option selected>16</option><option>20</option></select></div><textarea style="flex:1;font-family:monospace;resize:none;tab-size:2" spellcheck=false></textarea><small></small>`;
      const f = b.querySelector('input'),
        t = b.querySelector('textarea'),
        [bs, bn] = b.querySelectorAll('button'),
        fz = b.querySelector('select'),
        st = b.querySelector('small'),
        up = () =>
          (st.textContent = `${t.value.split('\n').length} lines · ${t.value.trim().split(/\s+/).filter(Boolean).length} words · ${t.value.length} chars`),
        save = () => {
          const q = f.value.split('/').filter(Boolean),
            n = cn(q.pop() || 'untitled.txt');
          mk(q.length ? q : ['Users', S.cu, 'Documents'])[n] = t.value;
          sv();
          ntf('Saved', n);
          R();
        };
      t.style.fontSize = 16 + 'px';
      t.oninput = up;
      fz.onchange = () => (t.style.fontSize = fz.value + 'px');
      bs.onclick = save;
      bn.onclick = () => {
        f.value = '';
        t.value = '';
        up();
      };
      t.onkeydown = e => {
        if (e.key == 'Tab') {
          e.preventDefault();
          document.execCommand('insertText', false, '  ');
        }
        if (e.ctrlKey && e.key == 's') {
          e.preventDefault();
          save();
        }
      };
      w.load = () => {
        if (EP) {
          f.value = EP.p.concat(EP.n).join('/');
          t.value = sub(EP.p)[EP.n];
          EP = null;
          up();
        }
      };
      w.load();
      up();
    }
  },
  viewer: {
    n: 'Photos',
    i: '🖼',
    sys: 1,
    st: 1,
    w: 560,
    h: 420,
    init: (b, w) => {
      let ks = [],
        i = 0,
        d,
        pn = [];
      const dr = () => {
        b.innerHTML = ks.length
          ? `<div class=row><span><button class=g data-a=p>◀</button> ${esc(ks[i])} (${i + 1}/${ks.length}) <button class=g data-a=n>▶</button></span><span><input type=range min=20 max=300 value=100 style=width:90px><button data-a=w>Set wallpaper</button></span></div><div style="overflow:auto;height:calc(100% - 52px);text-align:center"><img src="${d[ks[i]]}" style="width:100%"></div>`
          : '<p>Open a picture from Files (or save one from Paint / Camera).</p>';
        const z = b.querySelector('input');
        z && (z.oninput = () => (b.querySelector('img').style.width = z.value + '%'));
      };
      b.onclick = e => {
        const a = e.target.dataset.a;
        if (a == 'p') i = (i + ks.length - 1) % ks.length;
        else if (a == 'n') i = (i + 1) % ks.length;
        else if (a == 'w') {
          S.wallImg = d[ks[i]];
          sv();
          apply();
          return;
        } else return;
        dr();
      };
      w.load = () => {
        if (VP) {
          pn = VP.p;
          d = gt(pn);
          ks = Object.keys(d).filter(x => isImg(d[x]));
          i = Math.max(0, ks.indexOf(VP.n));
          VP = null;
        }
        dr();
      };
      w.load();
    }
  },
  media: {
    n: 'Media Player',
    i: '🎵',
    sys: 1,
    st: 1,
    w: 520,
    h: 430,
    init: (b, w) => {
      b.innerHTML =
        '<video controls style="width:100%;max-height:250px;background:#000;border-radius:8px"></video><div class=row><button class=g>📂 Open files</button><span><select><option>1</option><option>1.25</option><option>1.5</option><option>2</option></select>× <label><input type=checkbox> loop</label></span></div><div></div>';
      const v = b.firstChild,
        [bo] = b.querySelectorAll('button'),
        sp = b.querySelector('select'),
        lp = b.querySelector('input'),
        ls = b.lastChild;
      let L = [],
        n = -1;
      const pl = i => {
          n = i;
          v.src = L[i].u;
          v.playbackRate = +sp.value;
          v.play().catch(() => {});
          dr();
        },
        dr = () =>
          (ls.innerHTML =
            L.map(
              (x, i) =>
                `<div class=row style="cursor:pointer;${i == n ? 'color:var(--a)' : ''}" data-i=${i}>${i == n ? '▶' : '♪'} ${esc(x.n)}</div>`
            ).join('') || '<p>Open audio/video files from your computer, or from Files.</p>');
      bo.onclick = () => {
        const i = document.createElement('input');
        i.type = 'file';
        i.accept = 'audio/*,video/*';
        i.multiple = 1;
        i.onchange = () => {
          [...i.files].forEach(f => L.push({ n: f.name, u: URL.createObjectURL(f) }));
          L.length && n < 0 ? pl(0) : dr();
        };
        i.click();
      };
      ls.onclick = e => e.target.dataset.i && pl(+e.target.dataset.i);
      v.onended = () => {
        lp.checked ? pl(n) : n < L.length - 1 && pl(n + 1);
      };
      sp.onchange = () => (v.playbackRate = +sp.value);
      w.iv = setInterval(() => (v.volume = S.mute ? 0 : S.vol / 100), 400);
      w.load = () => {
        if (MP) {
          L.push({ n: MP.n, u: sub(MP.p)[MP.n] });
          MP = null;
          pl(L.length - 1);
        }
      };
      w.load();
      dr();
    }
  },
  camera: {
    n: 'Camera',
    i: '📷',
    sys: 1,
    st: 1,
    w: 480,
    h: 420,
    init: (b, w) => {
      b.innerHTML =
        '<video autoplay playsinline muted style="width:100%;max-height:300px;background:#000;border-radius:8px"></video><div class=row><button>Start</button><button class=g>📸 Snapshot</button><button class=g>Stop</button></div>';
      const v = b.firstChild,
        [st, sn, sp] = b.querySelectorAll('button');
      let m;
      const stop = () => {
        m && m.getTracks().forEach(t => t.stop());
        m = 0;
        v.srcObject = null;
      };
      w.stop = stop;
      st.onclick = () =>
        navigator.mediaDevices
          .getUserMedia({ video: true })
          .then(s => {
            m = s;
            v.srcObject = s;
          })
          .catch(e => ntf('Camera', e.message));
      sp.onclick = stop;
      sn.onclick = () => {
        if (!m) return;
        const c = document.createElement('canvas');
        c.width = v.videoWidth;
        c.height = v.videoHeight;
        c.getContext('2d').drawImage(v, 0, 0);
        const n = 'photo_' + (Date.now() % 1e6) + '.jpg';
        mk(['Users', S.cu, 'Pictures'])[n] = c.toDataURL('image/jpeg', 0.85);
        sv();
        ntf('Saved to Pictures', n);
      };
    }
  },
  calc: {
    n: 'Calculator',
    i: '🧮',
    st: 1,
    w: 300,
    h: 430,
    init: b => {
      const K = 'C ( ) ⌫ sin cos tan √ 7 8 9 ÷ 4 5 6 × 1 2 3 − 0 . ^ + π e % ='.split(' ');
      b.innerHTML = `<input style="width:100%;font-size:22px;text-align:right"><div class=grid style="grid-template-columns:repeat(4,1fr);margin:8px 0">${K.map(k => `<button class=g>${k}</button>`).join('')}</div><small></small>`;
      const d = b.firstChild,
        h = b.lastChild,
        ev = () => {
          try {
            let e = d.value
              .replace(/÷/g, '/')
              .replace(/×/g, '*')
              .replace(/−/g, '-')
              .replace(/\^/g, '**')
              .replace(/π/g, 'Math.PI')
              .replace(/\be\b/g, 'Math.E')
              .replace(/(sin|cos|tan)\(/g, 'Math.$1(')
              .replace(/√\(/g, 'Math.sqrt(');
            if (/[^\d+\-*/.()% ]/.test(e.replace(/Math\.(sin|cos|tan|sqrt|PI|E)/g, ''))) throw 0;
            const r = Function('return ' + e)();
            d.value = r;
          } catch (x) {
            d.value = 'Error';
          }
        };
      d.onkeydown = e => {
        if (e.key == 'Enter') ev();
      };
      b.onclick = e => {
        const k = e.target.textContent;
        if (e.target.tagName != 'BUTTON') return;
        if (d.value == 'Error') d.value = '';
        if (k == 'C') d.value = '';
        else if (k == '⌫') d.value = d.value.slice(0, -1);
        else if (k == '=') ev();
        else d.value += ['sin', 'cos', 'tan', '√'].includes(k) ? k + '(' : k;
      };
    }
  },
  clock: {
    n: 'Clock',
    i: '⏰',
    st: 1,
    w: 420,
    h: 430,
    init: (b, w) => {
      let t = 0,
        s0 = 0,
        s1 = 0,
        laps = [];
      const Z = [
          'UTC',
          'America/New_York',
          'America/Chicago',
          'America/Los_Angeles',
          'Europe/London',
          'Europe/Paris',
          'Asia/Dubai',
          'Asia/Kolkata',
          'Asia/Tokyo',
          'Australia/Sydney'
        ],
        f = ms =>
          `${(ms / 60000) | 0}:${String(((ms / 1000) % 60) | 0).padStart(2, '0')}.${String(((ms / 10) % 100) | 0).padStart(2, '0')}`;
      const dr = () => {
          b.innerHTML =
            `<div class=row style=justify-content:center>${['World', 'Stopwatch', 'Timer', 'Alarms'].map((x, i) => `<button class="${i == t ? '' : 'g'}" data-t=${i}>${x}</button>`).join('')}</div>` +
            [
              Z.map(z => `<div class=row>${z}<b data-z="${z}"></b></div>`).join(''),
              `<h1 style="text-align:center;font-family:monospace" id=sw></h1><div class=row style=justify-content:center><button data-a=ss>Start / Stop</button><button class=g data-a=lp>Lap</button><button class=g data-a=rs>Reset</button></div>` +
                laps.map((l, i) => `<div class=row>Lap ${i + 1}<b>${f(l)}</b></div>`).join(''),
              `<h1 style="text-align:center;font-family:monospace" id=tr></h1><div class=row style=justify-content:center><input id=tm type=number value=5 min=0 style=width:70px>min <input id=ts type=number value=0 min=0 style=width:70px>sec <button data-a=ts>Start</button><button class=g data-a=tc>Cancel</button></div>`,
              `<div class=row><input id=al type=time><button data-a=aa>Add alarm</button></div>` +
                S.alarms
                  .map(
                    (a, i) =>
                      `<div class=row><label><input type=checkbox ${a.on ? 'checked' : ''} data-a=at data-i=${i}> ${a.t}</label><button class=g data-a=ad data-i=${i}>✕</button></div>`
                  )
                  .join('')
            ][t];
          up();
        },
        up = () => {
          b.querySelectorAll('[data-z]').forEach(
            e => (e.textContent = new Date().toLocaleTimeString([], { timeZone: e.dataset.z }))
          );
          const a = b.querySelector('#sw');
          a && (a.textContent = f(s0 + (s1 ? Date.now() - s1 : 0)));
          const r = b.querySelector('#tr');
          r && (r.textContent = TME ? f(Math.max(0, TME - Date.now())) : '0:00.00');
        };
      b.onclick = e => {
        const x = e.target,
          a = x.dataset.a;
        if (x.dataset.t !== undefined) {
          t = +x.dataset.t;
          dr();
        } else if (a == 'ss') {
          s1 ? ((s0 += Date.now() - s1), (s1 = 0)) : (s1 = Date.now());
        } else if (a == 'lp' && s1) {
          laps.push(s0 + Date.now() - s1);
          dr();
        } else if (a == 'rs') {
          s0 = s1 = 0;
          laps = [];
          dr();
        } else if (a == 'ts') {
          TME =
            Date.now() +
            (+b.querySelector('#tm').value * 60 + +b.querySelector('#ts').value) * 1000;
        } else if (a == 'tc') TME = 0;
        else if (a == 'aa') {
          const v = b.querySelector('#al').value;
          if (v) {
            S.alarms.push({ t: v, on: 1 });
            sv();
            dr();
          }
        } else if (a == 'at') {
          S.alarms[x.dataset.i].on = x.checked ? 1 : 0;
          sv();
        } else if (a == 'ad') {
          S.alarms.splice(x.dataset.i, 1);
          sv();
          dr();
        }
      };
      w.iv = setInterval(up, 100);
      dr();
    }
  },
  calendar: {
    n: 'Calendar',
    i: '📅',
    st: 1,
    w: 480,
    h: 480,
    init: b => {
      const key = (y, m, i) => `${y}-${m + 1}-${i}`,
        n0 = new Date(),
        tk = key(n0.getFullYear(), n0.getMonth(), n0.getDate());
      let d = new Date(),
        sel = tk;
      const dr = () => {
        const y = d.getFullYear(),
          m = d.getMonth(),
          f = new Date(y, m, 1).getDay(),
          n = new Date(y, m + 1, 0).getDate();
        let h =
          `<div class=row><button class=g data-a=p>◀</button><b>${d.toLocaleString([], { month: 'long', year: 'numeric' })}</b><button class=g data-a=n>▶</button></div><div style="display:grid;grid-template-columns:repeat(7,1fr);gap:3px;text-align:center">` +
          'SMTWTFS'
            .split('')
            .map(x => `<small>${x}</small>`)
            .join('') +
          '<span></span>'.repeat(f);
        for (let i = 1; i <= n; i++) {
          const k = key(y, m, i);
          h += `<div data-k=${k} style="padding:8px 0;border-radius:8px;cursor:pointer;background:${(S.ev[k] || []).length ? 'var(--a)' : '#fff1'};outline:${k == sel ? '2px solid #fff' : '0'}">${i}</div>`;
        }
        h +=
          `</div><h4>${sel}</h4>` +
          (S.ev[sel] || [])
            .map((e, i) => `<div class=row>${esc(e)}<button class=g data-x=${i}>✕</button></div>`)
            .join('') +
          `<div class=row><input style=flex:1 placeholder="New event"><button data-a=a>Add</button></div>`;
        b.innerHTML = h;
      };
      b.onclick = e => {
        const t = e.target,
          a = t.dataset.a;
        if (a == 'p') d = new Date(d.getFullYear(), d.getMonth() - 1, 1);
        else if (a == 'n') d = new Date(d.getFullYear(), d.getMonth() + 1, 1);
        else if (a == 'a') {
          const v = b.querySelector('input').value.trim();
          if (v) {
            (S.ev[sel] = S.ev[sel] || []).push(v);
            sv();
          }
        } else if (t.dataset.x !== undefined) {
          S.ev[sel].splice(+t.dataset.x, 1);
          sv();
        } else if (t.dataset.k) sel = t.dataset.k;
        else return;
        dr();
      };
      dr();
    }
  },
  todo: {
    n: 'To-Do',
    i: '✅',
    w: 420,
    r: () =>
      `<div class=row><input id=ti placeholder="New task" style=flex:1 onkeydown="event.key=='Enter'&&tda()"><button onclick="tda()">Add</button></div>` +
      S.todo
        .map(
          (t, i) =>
            `<div class=row><label><input type=checkbox ${t.d ? 'checked' : ''} onchange="S.todo[${i}].d=this.checked;sv();R()"> <span style="${t.d ? 'text-decoration:line-through;opacity:.5' : ''}">${esc(t.t)}</span></label><button class=g onclick="S.todo.splice(${i},1);sv();R()">✕</button></div>`
        )
        .join('') +
      `<small>${S.todo.filter(t => !t.d).length} remaining</small>`
  },
  notes: {
    n: 'Sticky Notes',
    i: '📝',
    w: 500,
    r: () =>
      `<button onclick="S.notes.push({t:'',c:'#6d28d9'});sv();R()">+ New note</button><div class=grid style="grid-template-columns:repeat(auto-fill,200px);margin-top:8px">` +
      S.notes
        .map(
          (n, i) =>
            `<div style="background:${n.c};padding:8px;border-radius:10px"><textarea style="width:100%;height:100px;background:#0003;border:0" oninput="S.notes[${i}].t=this.value;sv()">${esc(n.t)}</textarea><div class=row style=border:0><input type=color value="${n.c}" onchange="S.notes[${i}].c=this.value;sv();R()"><button class=g onclick="S.notes.splice(${i},1);sv();R()">✕</button></div></div>`
        )
        .join('') +
      '</div>'
  },
  paint: {
    n: 'Paint',
    i: '🎨',
    st: 1,
    w: 620,
    h: 500,
    init: b => {
      b.innerHTML =
        '<div class=row style="padding:0"><input type=color value=#8b5cf6><input type=range min=1 max=40 value=4 style=width:80px><label><input type=checkbox>eraser</label><button class=g>Undo</button><button class=g>Clear</button><button>💾 Save</button></div><canvas width=800 height=520 style="background:#fff;max-width:100%;border-radius:8px;touch-action:none;margin-top:6px"></canvas>';
      const [co, sz1, er] = b.querySelectorAll('input'),
        [ud, cr, sv2] = b.querySelectorAll('button'),
        c = b.querySelector('canvas'),
        x = c.getContext('2d'),
        hist = [];
      let d = 0;
      const wh = () => {
          x.fillStyle = '#fff';
          x.fillRect(0, 0, 800, 520);
        },
        sn = () => {
          hist.push(x.getImageData(0, 0, 800, 520));
          hist.length > 15 && hist.shift();
        };
      wh();
      ud.onclick = () => hist.length && x.putImageData(hist.pop(), 0, 0);
      cr.onclick = () => {
        sn();
        wh();
      };
      sv2.onclick = () => {
        const n = 'paint_' + (Date.now() % 1e6) + '.png';
        mk(['Users', S.cu, 'Pictures'])[n] = c.toDataURL();
        sv();
        ntf('Saved to Pictures', n);
      };
      const pt2 = e => {
        const r = c.getBoundingClientRect();
        return [((e.clientX - r.left) * 800) / r.width, ((e.clientY - r.top) * 520) / r.height];
      };
      c.onpointerdown = e => {
        sn();
        d = 1;
        x.beginPath();
        x.moveTo(...pt2(e));
      };
      c.onpointerup = c.onpointerleave = () => (d = 0);
      c.onpointermove = e => {
        if (!d) return;
        x.strokeStyle = er.checked ? '#fff' : co.value;
        x.lineWidth = sz1.value;
        x.lineCap = x.lineJoin = 'round';
        x.lineTo(...pt2(e));
        x.stroke();
      };
    }
  },
  tools: {
    n: 'Dev Tools',
    i: '🧰',
    st: 1,
    w: 560,
    h: 470,
    init: b => {
      b.innerHTML =
        '<textarea style="width:100%;height:110px" placeholder="Input…"></textarea><div class=row style="flex-wrap:wrap;justify-content:flex-start">' +
        Object.keys(T)
          .map(k => `<button class=g>${k}</button>`)
          .join('') +
        '</div><textarea style="width:100%;height:150px" readonly></textarea>';
      const [i, o] = b.querySelectorAll('textarea');
      b.onclick = async e => {
        const f = T[e.target.textContent];
        if (e.target.tagName == 'BUTTON' && f)
          try {
            o.value = await f(i.value);
          } catch (x) {
            o.value = 'Error: ' + x.message;
          }
      };
    }
  },
