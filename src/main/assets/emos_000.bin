<!doctypehtml><html lang=en><meta charset=utf-8><meta content="width=device-width,initial-scale=1,viewport-fit=cover"name=viewport><title>EmOS</title><link href=data:, rel=icon><style>*{box-sizing:border-box}body,html{height:100%;margin:0;overflow:hidden;background:#050816;color:#e8eaff;font:14px var(--f)}:root{--a:#8b5cf6;--f:system-ui,sans-serif;--r:12px;--g:rgba(16, 20, 62, 0.88);--ln:rgba(139, 92, 246, 0.4)}body.big{font-size:17px}body.hc{--g:#000;--ln:#fff}#os{position:fixed;inset:0;display:flex;flex-direction:column;padding:env(safe-area-inset-top,0) 0 env(safe-area-inset-bottom,0);background:#050816}#desk{flex:1;position:relative;overflow:hidden;background-size:cover}#tb{height:48px;display:flex;align-items:center;gap:6px;padding:0 8px;background:rgba(8,10,38,.94);border-top:1px solid var(--ln);position:relative;z-index:99998}#apps{display:flex;gap:4px;position:absolute;left:50%;transform:translateX(-50%);max-width:calc(100% - 600px);overflow:auto}#vd{margin-left:auto}.lb,.tbi{padding:5px 9px;border-radius:8px;cursor:pointer;font-size:18px}.lb:hover,.tbi:hover{background:#fff2}.tbi.on{background:var(--a)}.bi,.blob{display:inline-block;width:30px;height:28px;background:var(--bi) center/contain no-repeat;vertical-align:middle}.bi{width:1.15em;height:1.05em}@keyframes bob{50%{transform:translateY(-7px)}}@keyframes fl{to{transform:translateY(-70px);opacity:0}}#vd span{padding:3px 7px;margin:0 1px;border-radius:6px;cursor:pointer;background:#fff1}#vd .on{background:var(--a)}#tray{display:flex;gap:8px;cursor:pointer;padding:4px 8px;border-radius:8px}#clk:hover,#tray:hover{background:#fff2}#clk{cursor:pointer;padding:4px 8px;border-radius:8px;text-align:center;font-size:12px}.win{position:absolute;min-width:260px;min-height:160px;background:var(--g);backdrop-filter:blur(18px);border:1px solid var(--ln);border-radius:var(--r);display:flex;flex-direction:column;resize:both;overflow:hidden;box-shadow:0 12px 40px #0009}body.anim .win{animation:pop .18s}@keyframes pop{from{transform:scale(.94);opacity:0}}.win.on{border-color:var(--a)}.tb{display:flex;justify-content:space-between;padding:7px 10px;background:#0006;cursor:move;user-select:none;touch-action:none}.tb i{font-style:normal;padding:2px 8px;cursor:pointer;border-radius:6px}.tb i:hover{background:#fff3}.tb i.x:hover{background:#e11d48}.bd{flex:1;overflow:auto;padding:12px}button{background:var(--a);border:0;color:#fff;padding:6px 12px;border-radius:8px;cursor:pointer;font:inherit}button.g{background:#fff2}input,select,textarea{background:#0008;color:inherit;border:1px solid var(--ln);border-radius:8px;padding:6px;font:inherit}.row{display:flex;justify-content:space-between;align-items:center;padding:7px 0;border-bottom:1px solid #fff1;gap:10px}h4{margin:14px 0 4px;color:var(--a)}.bar{flex:1;height:8px;background:#fff2;border-radius:4px;overflow:hidden}.bar i{display:block;height:100%;background:var(--a)}.grid{display:grid;grid-template-columns:repeat(auto-fill,88px);gap:8px}.ic{text-align:center;padding:8px 4px;border-radius:10px;cursor:pointer;font-size:12px;user-select:none}.ic:hover{background:#fff2}.ic b{display:block;font-size:30px;font-weight:400}#icons{position:absolute;left:10px;top:10px;bottom:10px;display:grid;grid-auto-flow:column;grid-template-rows:repeat(auto-fill,84px);grid-auto-columns:88px;gap:4px;color:#fff;pointer-events:none}#icons .ic{pointer-events:auto}.sv *{backdrop-filter:none!important;animation:none!important}a{color:var(--a)}#wd{position:absolute;right:14px;top:14px;width:210px;display:grid;gap:10px}.wg{background:var(--g);border:1px solid var(--ln);border-radius:var(--r);padding:12px;backdrop-filter:blur(12px)}.pn{position:absolute;right:8px;bottom:56px;width:330px;max-width:calc(100% - 16px);background:var(--g);backdrop-filter:blur(22px);border:1px solid var(--ln);border-radius:var(--r);padding:14px;display:none;z-index:999999}.pn.s{display:block}.tiles{display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px;margin-bottom:10px}.tile{background:#fff1;border-radius:10px;padding:10px 4px;text-align:center;cursor:pointer;font-size:12px}.tile.on{background:var(--a)}#ln{left:8px;right:auto;width:560px;height:480px;overflow:auto}#lr{margin-top:10px}#toasts{position:fixed;right:10px;top:10px;z-index:9999999;display:grid;gap:6px}.toast{background:var(--g);border:1px solid var(--a);border-radius:10px;padding:10px 14px;max-width:280px}#cm{position:fixed;background:var(--g);border:1px solid var(--ln);border-radius:10px;padding:4px;z-index:9999999;display:none}#cm div{padding:6px 14px;cursor:pointer;border-radius:6px}#cm div:hover{background:var(--a)}#boot,#lock,#off{position:fixed;inset:0;z-index:99999999;background:radial-gradient(circle at 30% 20%,#4c1d95,transparent 55%),linear-gradient(160deg,#050a30,#1b0f4a);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:14px;text-align:center}#off{background:#000}#boot{background:#050816}#boot .blob{transform:scale(3);margin:30px}.av{width:64px;height:64px;border-radius:50%;background:var(--a);display:flex;align-items:center;justify-content:center;font-size:28px;margin:auto}.ua{cursor:pointer;padding:10px;border-radius:12px}.ua:hover{background:#fff2}#night{position:fixed;inset:0;background:rgba(255,140,0,.18);mix-blend-mode:multiply;pointer-events:none;z-index:9999998;display:none}#cap{position:fixed;bottom:60px;left:50%;transform:translateX(-50%);background:#000c;padding:8px 18px;border-radius:8px;z-index:9999999;display:none}.sx{container-type:inline-size;display:flex;position:absolute;inset:0;min-height:0;font-size:13px}.sxp,.sxw{min-height:0}.sxs{width:190px;padding:14px 10px;background:#0004;border-right:1px solid var(--ln);display:flex;flex-direction:column;gap:2px;overflow:auto;flex:none}.sxs div{padding:8px 10px;border-radius:9px;cursor:pointer;display:flex;gap:8px;align-items:center}.sxs div:hover{background:#fff1}.sxs div.on{background:var(--a);color:#fff}.sxs em{margin-left:auto;font-style:normal;opacity:.7;font-size:11px}.sxs h5{margin:12px 10px 4px;font-size:11px;opacity:.5;letter-spacing:1px;text-transform:uppercase}.sxw{flex:1;display:flex;flex-direction:column;min-width:0}.sxt{padding:12px 16px;display:flex;gap:10px;align-items:center}.sxt input{flex:1;border-radius:20px;padding:8px 14px}.sxp{flex:1;overflow:auto;padding:4px 16px 20px}.sxh{border-radius:18px;padding:24px;margin-bottom:6px;display:flex;align-items:center;gap:20px;color:#fff;min-height:150px}.sxh .big{font-size:64px;filter:drop-shadow(0 6px 12px #0006)}.sxh small{letter-spacing:2px;opacity:.8}.sxh h2{margin:4px 0}.sxh button{background:#fff;color:#111;margin-top:8px;font-weight:600}.sxd{display:flex;gap:6px;justify-content:center;margin:8px 0 14px}.sxd i{width:7px;height:7px;border-radius:4px;background:#fff4;cursor:pointer}.sxd i.on{width:20px;background:var(--a)}.sxp h3{margin:18px 0 10px;font-size:16px}.sxg{display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:10px}.sxc{display:flex;gap:12px;align-items:center;padding:12px;border-radius:14px;background:#fff1;cursor:pointer;transition:.15s}.sxc:hover{background:#fff2;transform:translateY(-2px)}.sxc .m{flex:1;min-width:0}.sxc .m b,.sxc .m small{display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.sxc small,.sxi2 small{opacity:.65}.sxi{width:52px;height:52px;border-radius:14px;display:flex;align-items:center;justify-content:center;font-size:28px;flex:none;box-shadow:0 4px 12px #0005}.sxi.l{width:96px;height:96px;font-size:52px;border-radius:24px}.sxb{border-radius:16px;padding:5px 16px;font-weight:600;min-width:64px}.sxb.g{background:#fff2}.sxpr{display:inline-block;width:64px;height:6px;border-radius:3px;background:#fff3;overflow:hidden}.sxpr i{display:block;height:100%;background:var(--a);animation:sxl .7s linear forwards}@keyframes sxl{from{width:0}to{width:100%}}.sxdt{display:flex;gap:20px;align-items:center;margin:10px 0 18px;flex-wrap:wrap}.sxdt h2{margin:0 0 4px}.sxch{display:inline-block;padding:3px 10px;border-radius:12px;background:#fff2;margin:8px 6px 0 0;font-size:12px}.sxst span{font-size:22px;cursor:pointer;opacity:.35}.sxst span.on{opacity:1;color:#fbbf24}.sxlk{opacity:.7;cursor:pointer;margin-bottom:6px}.sxrh{display:flex;justify-content:space-between;align-items:baseline}.sxrh a{font-size:12px;opacity:.8;cursor:pointer;color:inherit}.sxrh a:hover{opacity:1;text-decoration:underline}.sxhb{display:flex;gap:8px;flex-wrap:wrap;margin-top:10px}.sxh .sxhb button{margin-top:0}.sxh button.g{background:#fff3;color:#fff}@container (max-width:640px){.sxs{width:56px}.sxs .l,.sxs em,.sxs h5{display:none}.sxs div{justify-content:center}.sxh .big{font-size:40px}}</style><body class=anim><div id=os><div id=desk oncontextmenu=ctx(event,0)><div id=icons></div><div id=wd><div class=wg><div id=wc style=font-size:28px></div><div id=wdt></div></div><div id=ws class=wg></div></div></div><div id=tb><div class=lb onclick=lnt() title="Launcher (Ctrl+Space)"><span class=blob></span></div><div class=lb onclick=lnt(1)>🔍</div><div id=apps></div><div id=vd></div><div id=tray onclick='pt("qs")'></div><div id=clk onclick='pt("nc")'></div></div><div id=ln class=pn><input id=lq oninput=lnR(this.value) placeholder="Search apps, files, settings, web…"style=width:100%><div id=lr></div><div class=row style=margin-top:10px><span id=lu></span><span><button class=g onclick=lk()>🔒 Lock</button> <button class=g onclick=slp()>😴 Sleep</button> <button class=g onclick=pwr(1)>⟳ Restart</button> <button class=g onclick=pwr(0)>⏻ Off</button></span></div></div><div id=qs class=pn></div><div id=nc class=pn></div></div><div id=toasts></div><div id=cm></div><div id=night></div><div id=cap></div><div id=lock></div><div id=boot><div class=blob></div><h2>EmOS</h2></div><div id=off onclick=boot() style=display:none></div><script>const BIMG =
  'data:image/png;base64,';
document.documentElement.style.setProperty('--bi', 'url(' + BIMG + ')');
document.querySelector('link[rel=icon]').href = BIMG;
const $ = s => document.querySelector(s),
  J = JSON.stringify,
  H = (s, h) => ($(s).innerHTML = h),
  cp = o => JSON.parse(J(o));
const WP = [
  'radial-gradient(circle at 20% 20%,#6d28d9aa,transparent 50%),radial-gradient(circle at 80% 70%,#1d4ed8aa,transparent 55%),linear-gradient(160deg,#0a0f3a,#1b0f4a)',
  'linear-gradient(135deg,#0b1030,#312e81 60%,#7c3aed)',
  'radial-gradient(circle at 50% 110%,#7c3aed,#0b1030 62%)',
  'linear-gradient(200deg,#020617,#1e3a8a)'
];
const D = {
  acc: '#8b5cf6',
  wall: 0,
  font: 'system-ui,sans-serif',
  anim: 1,
  rad: 12,
  scale: '1',
  wifi: 1,
  bt: 1,
  air: 0,
  dnd: 0,
  night: 0,
  vol: 60,
  br: 100,
  mute: 0,
  out: 'Speakers',
  mic: 1,
  cam: 1,
  loc: 0,
  pw: 'balanced',
  hc: 0,
  big: 0,
  cap: 0,
  sr: 0,
  mag: 0,
  fw: 1,
  av: 1,
  upd: 1,
  cloud: '',
  sync: 0,
  vpn: 0,
  dns: '1.1.1.1',
  proxy: '',
  eth: 1,
  res: '1920x1080',
  hz: '60',
  mon: 0,
  ver: '2.0',
  ev: {},
  todo: [],
  notes: [{ t: 'Welcome to EmOS 💜', c: '#6d28d9' }],
  alarms: [],
  trash: [],
  hist: [],
  idle: 0,
  hs: [0, 0, 0],
  restore: 1,
  bbot: { cfg: { provider: 'free', url: 'https://text.pollinations.ai/openai', key: '', model: 'openai', speak: 0 }, chat: [], hist: [], macros: {}, jobs: [] },
  bub: { c: 0, h: 80, f: 80, e: 80, xp: 0, hat: '', own: [], t: 0 },
  wallImg: '',
  ssid: 'EmOS-5G',
  saved: ['EmOS-5G'],
  pair: ['Headphones'],
  note: '',
  scan: 'never',
  bk: [],
  cu: '',
  users: [
    { n: 'Emmett', pw: 'hossman21', a: 1 },
    { n: 'Ryan', pw: 'Monday12%', a: 1 },
    { n: 'Guest', pw: '', a: 0 }
  ],
  inst: [
    'files',
    'settings',
    'monitor',
    'term',
    'store',
    'sec',
    'net',
    'dev',
    'backup',
    'logs',
    'clip',
    'trash',
    'editor',
    'calc',
    'clock',
    'calendar',
    'todo',
    'notes',
    'media',
    'paint',
    'viewer',
    'camera',
    'tools',
    'weather',
    'convert',
    'screenrec',
    'browser',
    'htmled',
    'bubberbot'
  ],
  pins: ['browser', 'bubberbot', 'files', 'settings', 'term', 'store', 'editor', 'calc', 'calendar', 'clock', 'paint', 'notes', 'weather', 'monitor'],
  fs: {
    Users: {
      Emmett: { Documents: { 'readme.txt': 'Welcome to EmOS!' }, Pictures: {}, Downloads: {} },
      Guest: { Documents: {} }
    },
    Drives: { 'C:': { System: {} } }
  }
};
let S = cp(D);
const SK = { fs: 'emos_fs', bk: 'emos_bk', wallImg: 'emos_img' },
  SC = {};
try {
  Object.assign(S, JSON.parse(localStorage.emos));
  for (const k in SK) {
    const v = localStorage[SK[k]];
    if (v != null) S[k] = k == 'wallImg' ? v : JSON.parse(v);
  }
} catch (e) {}
const sv = () => {
  let ok = 1;
  const put = (k, v) => {
    if (SC[k] === v) return;
    try {
      localStorage[k] = v;
      SC[k] = v;
    } catch (e) {
      ok = 0;
    }
  };
  const core = {};
  for (const k in S) if (!(k in SK)) core[k] = S[k];
  put('emos', J(core));
  for (const k in SK) put(SK[k], k == 'wallImg' ? S[k] || '' : J(S[k]));
  if (!ok) {
    window.SVF || ntf('Storage full', 'Some data could not be saved - remove large files or old backups');
    window.SVF = 1;
  } else window.SVF = 0;
};
let LG = [['--', 'i', 'EmOS kernel booted']],
  N = [],
  CB = [],
  W = {},
  z = 10,
  nid = 0,
  DK = 0,
  fp = [],
  tcw = [],
  LU = 0,
  CPU = 12,
  RAM = 40,
  NET = 2,
  BAT = 87,
  SEL = '';
let BO = null;
try {
  navigator.getBattery &&
    navigator.getBattery().then(b => {
      BO = b;
      b.addEventListener('levelchange', () => tray());
      b.addEventListener('chargingchange', () => tray());
    });
} catch (e) {}
const log = (l, m) => {
  LG.unshift([new Date().toLocaleTimeString(), l, m]);
  LG.length > 150 && LG.pop();
};
const adm = () => (S.users.find(u => u.n == S.cu) || {}).a;
const say = t => {
  if (S.sr)
    try {
      speechSynthesis.cancel();
      speechSynthesis.speak(new SpeechSynthesisUtterance(t));
    } catch (e) {}
};
function ntf(t, b = '') {
  N.unshift({ t, b, ts: new Date().toLocaleTimeString() });
  log('i', 'Notify: ' + t);
  if (!S.dnd) {
    const e = document.createElement('div');
    e.className = 'toast';
    e.innerHTML = `<b>${t}</b><br>${b}`;
    $('#toasts').append(e);
    setTimeout(() => e.remove(), 3500);
  }
  if (S.cap) {
    const c = $('#cap');
    c.textContent = 'CC: ' + t;
    c.style.display = 'block';
    setTimeout(() => (c.style.display = 'none'), 3000);
  }
  say(t);
  try {
    document.hidden && Notification.permission == 'granted' && new Notification(t, { body: b });
  } catch (e) {}
}
function apply() {
  const r = document.documentElement.style;
  r.setProperty('--a', S.acc);
  r.setProperty('--f', S.font);
  r.setProperty('--r', S.rad + 'px');
  $('#desk').style.backgroundImage = S.wallImg ? `url(${S.wallImg})` : WP[S.wall];
  $('#desk').style.backgroundPosition = 'center';
  $('#desk').style.zoom = S.scale * (S.mag ? 1.4 : 1);
  $('#os').style.filter = `brightness(${S.br / 100})`;
  $('#night').style.display = S.night ? 'block' : 'none';
  const c = document.body.classList;
  c.toggle('anim', !!S.anim && S.pw != 'saver');
  c.toggle('hc', !!S.hc);
  c.toggle('sv', S.pw == 'saver');
  c.toggle('big', !!S.big);
  tray();
}
function set(k, v, nr) {
  S[k] = v;
  sv();
  apply();
  nr || R();
  if (k == 'air' && v) {
    S.wifi = 0;
    S.bt = 0;
  }
}
function tray() {
  H(
    '#tray',
    `<span>${navigator.onLine ? '🌐' : '⛔'}</span><span>${S.mute ? '🔇' : '🔊'}</span>${BO ? `<span>${BO.charging ? '⚡' : '🔋'}${Math.round(BO.level * 100)}%</span>` : ''}`
  );
}
let FPS = 0,
  LAG = 0,
  HEAP = 'n/a',
  SU = '…',
  UP = Date.now(),
  lt = performance.now(),
  fr = 0,
  lastAct = Date.now(),
  lasts = '',
  TME = 0,
  tc = 0;
(function lp() {
  fr++;
  requestAnimationFrame(lp);
})();
setInterval(() => {
  const d = new Date(),
    n = performance.now();
  LAG = Math.max(0, n - lt - 1000);
  lt = n;
  FPS = fr;
  fr = 0;
  HEAP = performance.memory
    ? (performance.memory.usedJSHeapSize / 1048576).toFixed(0) + ' MB'
    : 'n/a';
  if (tc++ % 5 == 0 && navigator.storage && navigator.storage.estimate)
    navigator.storage
      .estimate()
      .then(
        e =>
          (SU =
            (e.usage / 1048576).toFixed(1) +
            ' MB used of ' +
            (e.quota / 1073741824).toFixed(1) +
            ' GB')
      )
      .catch(() => {});
  H(
    '#clk',
    d.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) +
      '<br>' +
      d.toLocaleDateString()
  );
  H('#wc', d.toLocaleTimeString());
  H('#wdt', d.toDateString());
  const tk = `${d.getFullYear()}-${d.getMonth() + 1}-${d.getDate()}`;
  H(
    '#ws',
    `${FPS} fps · heap ${HEAP}<br>${navigator.onLine ? '🟢 online' : '🔴 offline'}${BO ? ' · 🔋' + Math.round(BO.level * 100) + '%' : ''}<br>✅ ${S.todo.filter(t => !t.d).length} tasks · 📅 ${(S.ev[tk] || []).length} today`
  );
  const l = $('#lkc');
  if (l) l.textContent = d.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
  const hm = d.toTimeString().slice(0, 5);
  if (hm != lasts) {
    lasts = hm;
    S.alarms.forEach(a => a.on && a.t == hm && (ntf('⏰ Alarm', hm), beep(880)));
  }
  if (TME && Date.now() >= TME) {
    TME = 0;
    ntf('⏲ Timer finished');
    beep(880);
  }
  const id = +S.idle;
  if (id && $('#lock').style.display == 'none' && Date.now() - lastAct > id * 6e4) lk();
  tray();
}, 1000);
/* windows */
function op(id) {
  const a = APPS[id];
  if (!a) return;
  try {
    stx().use[id] = (stx().use[id] || 0) + 1;
  } catch (e) {}
  let w = Object.values(W).find(x => x.id == id);
  if (w) {
    w.d = DK;
    show(w);
    w.load && w.load();
    return;
  }
  const k = ++nid,
    e = document.createElement('div');
  e.className = 'win';
  e.style.cssText = `left:${70 + (k % 6) * 32}px;top:${30 + (k % 6) * 28}px;width:${a.w || 560}px;height:${a.h || 400}px;max-width:100%;`;
  e.innerHTML = `<div class=tb><b>${a.i} ${a.n}</b><span><i onclick="mv(${k})" title="Move to next desktop">⧉</i><i onclick="mn(${k})">–</i><i onclick="mx(${k})">▢</i><i class=x onclick="cl(${k})">✕</i></span></div><div class=bd></div>`;
  $('#desk').append(e);
  w = W[k] = { k, id, e, d: DK, min: 0, max: 0, pid: 1000 + k * 7, t0: Date.now() };
  drag(w);
  e.onpointerdown = () => fo(w);
  a.init && a.init(e.lastChild, w);
  a.st || (e.lastChild.innerHTML = a.r());
  fo(w);
  vis();
  log('i', 'Started ' + a.n);
}
function fo(w) {
  Object.values(W).forEach(x => {
    x.on = 0;
    x.e.classList.remove('on');
  });
  w.on = 1;
  w.e.classList.add('on');
  w.e.style.zIndex = ++z;
  tbar();
}
function show(w) {
  w.min = 0;
  fo(w);
  vis();
}
const vis = () => {
  Object.values(W).forEach(w => (w.e.style.display = w.d == DK && !w.min ? '' : 'none'));
  tbar();
};
const mn = k => {
    W[k].min = 1;
    W[k].on = 0;
    vis();
  },
  mv = k => {
    W[k].d = (W[k].d + 1) % 4;
    vis();
  };
function cl(k) {
  const w = W[k];
  if (!w) return;
  clearInterval(w.iv);
  w.stop && w.stop();
  w.e.remove();
  delete W[k];
  tbar();
}
function tbar() {
  H(
    '#apps',
    Object.values(W)
      .filter(w => w.d == DK)
      .map(
        w =>
          `<div class="tbi ${w.on && !w.min ? 'on' : ''}" onclick="tgw(${w.k})" title="${APPS[w.id].n}">${APPS[w.id].i}</div>`
      )
      .join('')
